      "permissions": [],
      "lockString": ""
    },
    {
      "id": "blackspire_hall_room_0014",
      "title": "Dreadthorn Path",
      "roomType": "",
      "description": "Twisted black-barked trees crowd the edges of this narrow path, their thorned branches forming a crooked canopy overhead.\nRough dwellings and small fenced plots grow sparse as the trail winds farther from the center of Blackspire Hall.\nBeyond the last structures, Dreadthorn Path leads toward the dangerous wild lands claimed by Mordrath.",
