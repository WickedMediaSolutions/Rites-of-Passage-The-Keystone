    {
      "id": "blackspire_hall_room_0018",
      "title": "The Crimson Edge",
      "roomType": "",
      "description": "Blades of every shape line the walls of this grim weaponsmith's shop, from narrow daggers to heavy axes and brutal war swords.\nSharpening stones, weapon oil, and smithing tools cover a reinforced bench behind the counter where damaged steel is restored for battle.\nThe sharp scent of hot metal fills the room, while the shop's name hints at the color many of these weapons eventually earn.",
      "x": -48,
      "y": -63,
      "z": 0,
      "tags": [],
      "notes": "",
      "typeclassPath": "",
      "aliases": [],
      "evenniaTags": [],
      "attributes": [],
      "permissions": [],
      "lockString": ""
    },
    {
      "id": "blackspire_hall_room_0019",
      "title": "Sanctuary of the Blooded Hand",
      "roomType": "",
      "description": "Dim red lamps illuminate rows of narrow beds where wounded Mordrath warriors are treated beneath the watch of stern healers.\nShelves hold bandages, bitter medicines, dried herbs, surgical tools, and dark glass bottles whose contents are best left unquestioned.\nMercy is scarce in Blackspire Hall, but those still strong enough to fight are restored here and sent back into the world.",
      "x": -45,
      "y": -69,
      "z": 0,
