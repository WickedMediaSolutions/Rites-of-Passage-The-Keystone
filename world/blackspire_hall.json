  "version": 1,
  "rooms": [
    {
      "id": "blackspire_hall_room_0001",
      "title": "Blackspire Sanctuary",
      "roomType": "",
      "description": "Cold violet fire burns within iron braziers, casting long shadows across black stone walls carved with the sigils of Mordrath.\nTall obsidian pillars surround the chamber, their surfaces scarred by age, war, and the rites of generations who came before.\nHeavy doors open toward Blackspire Hall, where new adventurers leave the sanctuary behind and enter a harsher world.",
      "x": -48,
      "y": -68,
      "z": 0,
      "tags": [],
      "notes": "",
      "typeclassPath": "",
      "aliases": [],
      "evenniaTags": [],
      "attributes": [],
      "permissions": [],
      "lockString": ""
    },
    {
      "id": "blackspire_hall_room_0005",
      "title": "Shadowmarch Way",
      "roomType": "",
      "description": "A broad road of dark fitted stone cuts through the heart of Blackspire Hall, polished smooth by soldiers, merchants, and countless marching boots.\nBlack-and-crimson Mordrath banners hang from iron standards above the street, snapping sharply whenever the wind moves through the settlement.\nFortified buildings and narrow side streets crowd its edges, giving the road the feel of both marketplace and military artery.",
      "x": -47,
      "y": -68,
      "z": 0,
