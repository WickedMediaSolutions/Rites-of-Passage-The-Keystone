    {
      "id": "blackspire_hall_room_0012",
      "title": "The Blackened Anvil",
      "roomType": "",
      "description": "Heavy armor of dark steel, boiled leather, and blackened mail hangs from iron hooks and racks along the soot-covered walls.\nA roaring forge burns behind a scarred workbench, throwing harsh orange light across shields, helms, and unfinished breastplates.\nThe armorer works beneath a constant shower of sparks, crafting protection meant to survive the brutal battles beyond Blackspire Hall.",
      "x": -45,
      "y": -65,
      "z": 0,
      "tags": [],
      "notes": "",
      "typeclassPath": "",
      "aliases": [],
