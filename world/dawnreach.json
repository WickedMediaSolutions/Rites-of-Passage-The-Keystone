  "rooms": [
    {
      "id": "dawnreach_room_0001",
      "title": "Dawnreach Sanctuary",
      "roomType": "",
      "description": "Warm golden light filters through tall arched windows, illuminating pale stone walls carved with the ancient symbols of the Valroian people.\nRows of polished columns frame a peaceful chamber where new adventurers first awaken to the greater world beyond.\nHeavy doors stand open toward Dawnreach, while the quiet sanctuary behind them offers one final moment of safety.",
      "x": -48,
      "y": -68,
      "z": 0,
      "tags": [],
      "notes": "",
      "typeclassPath": "",
      "aliases": [],
      "evenniaTags": [],
      "attributes": [],
      "permissions": [],
      "lockString": ""
    },
    {
      "id": "dawnreach_room_0005",
      "title": "Dawnward Way",
      "roomType": "",
      "description": "A broad cobbled avenue stretches through the heart of Dawnreach, worn smooth beneath generations of travelers, soldiers, and merchants.\nBanners bearing the colors of the Valroian people hang from iron posts, stirring gently above the bustling roadway.\nShops, homes, and branching streets crowd its edges, making this the lifeblood of the settlement.",
