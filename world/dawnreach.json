    {
      "id": "dawnreach_room_0018",
      "title": "The Silver Edge",
      "roomType": "",
      "description": "Swords, axes, maces, daggers, and other weapons fill carefully arranged racks throughout this surprisingly orderly weaponsmith\u0027s shop.\nBehind the counter, whetstones and smithing tools surround a heavy workbench where damaged blades are restored to deadly sharpness.\nThe faint scent of hot steel and weapon oil hangs in the air as adventurers search for something worthy of carrying into battle.",
      "x": -48,
      "y": -63,
      "z": 0,
      "tags": [],
