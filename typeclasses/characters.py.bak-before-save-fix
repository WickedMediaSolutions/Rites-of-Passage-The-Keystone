"""
Rites of Passage — Character Typeclass

Gameplay data is persisted via Evennia attributes and accessed through
the ``CharacterData`` handler so combat, progression, and resources
all read from a single authoritative source.
"""

from evennia.objects.objects import DefaultCharacter

from world.data.character_data import CharacterData
from world.data import progression as _prog
from world.data.constants import REGENERATION_TICK_SECONDS
from world.data.enums import CharacterState, Faction, Stat
from world.data.regeneration import regen_tick
from .objects import ObjectParent

# Single attribute key for the serialised CharacterData dict.
GAME_DATA_ATTR = "rop_game_data"
# Set after first _init_game_data so reloads don't re-init.
INIT_FLAG_ATTR = "rop_initialised"


class Character(ObjectParent, DefaultCharacter):
    """Rites of Passage player character."""

    # ------------------------------------------------------------------
    # at_object_creation — idempotent initialisation
    # ------------------------------------------------------------------

    def at_object_creation(self):
        """Called once when the object is first created."""
        super().at_object_creation()
        # Defensive: ensure db_date_created is never None, which would
        # cause a crash in Evennia's _TO_DATESTRING serialization.
        from django.utils import timezone as _tz
        if self.__dict__.get("db_date_created") is None:
            object.__setattr__(self, "db_date_created", _tz.now())
        if not self.attributes.has(INIT_FLAG_ATTR):
            self._init_game_data()
            self.attributes.add(INIT_FLAG_ATTR, True)

    def _init_game_data(self):
        """Create a fresh empty game-data block."""
        self._save_game_data(CharacterData())

    # ------------------------------------------------------------------
    # game property — load / save bridge
    # ------------------------------------------------------------------

    @property
    def game(self) -> CharacterData:
        """Return CharacterData loaded from persistent storage."""
        if not hasattr(self, "_game_cache"):
            raw = self.attributes.get(GAME_DATA_ATTR, default={})
            self._game_cache = CharacterData.from_dict(raw)
        return self._game_cache

    def _save_game_data(self, cd: CharacterData) -> None:
        """Persist a CharacterData instance back to Evennia attrs."""
        self.attributes.add(GAME_DATA_ATTR, cd.to_dict())
        self._game_cache = cd

    def save(self) -> None:
        """Persist any in-memory CharacterData changes."""
        if hasattr(self, "_game_cache") and self._game_cache is not None:
            self._save_game_data(self._game_cache)

    # ------------------------------------------------------------------
    # Character initialisation (called by chargen)
    # ------------------------------------------------------------------

    def init_character(self, race_id: str, profession_id: str) -> None:
        """Initialise a newly created character with rolled stats and
        Level-1 skill grants."""
        cd = CharacterData.create_from_race_profession(
            self.key, race_id, profession_id,
        )
        cd.max_hp = 100; cd.hp = 100
        cd.max_mana = 100; cd.mana = 100
        cd.max_stamina = 100; cd.stamina = 100
        cd.race_id = race_id
        cd.profession_id = profession_id

        # Grant Level-1 universal + profession skills.
        _prog.grant_starting_skills(cd)

        self._save_game_data(cd)

    # ------------------------------------------------------------------
    # Identity
    # ------------------------------------------------------------------

    @property
    def race_id(self) -> str: return self.game.race_id

    @property
    def profession_id(self) -> str: return self.game.profession_id

    @property
    def faction(self) -> Faction | None: return self.game.faction

    # ------------------------------------------------------------------
    # Progression (Phase 3)
    # ------------------------------------------------------------------

    @property
    def level(self) -> int: return self.game.level

    @level.setter
    def level(self, value: int) -> None:
        self.game.level = value

    @property
    def xp(self) -> int: return self.game.xp

    @xp.setter
    def xp(self, value: int) -> None:
        self.game.xp = value


    @property
    def tutorial_completed(self) -> bool:
        return self.game.tutorial_completed

    @tutorial_completed.setter
    def tutorial_completed(self, value: bool) -> None:
        self.game.tutorial_completed = value

    def award_xp(self, amount: int) -> int:
        """Add XP and process any level-ups.  Returns new level."""
        new_level, _ = _prog.award_xp(self.game, amount)
        self.save()
        return new_level

    def xp_to_next(self) -> int:
        """XP still needed for the next level."""
        return _prog.xp_to_next_level(self.level)

    def xp_progress(self) -> int:
        """XP earned since the current level's threshold (for death penalty)."""
        return _prog.xp_progress_toward_next(self.xp, self.level)

    def current_level_threshold(self) -> int:
        """Minimum XP that anchors the current level (never de-level below)."""
        return _prog.xp_for_level(self.level)

    # ------------------------------------------------------------------
    # Stats
    # ------------------------------------------------------------------


    def get_stat(self, stat: Stat | str) -> int:
        return self.game.get_stat(stat)

    def effective_stat(self, stat: Stat | str) -> int:
        return self.game.effective_stat(stat)

    @property
    def base_stats(self) -> dict:
        return dict(self.game.base_stats)

    # ------------------------------------------------------------------
    # State
    # ------------------------------------------------------------------


    @property
    def state(self) -> CharacterState:
        return self.game.state

    @state.setter
    def state(self, value: CharacterState) -> None:
        if not isinstance(value, CharacterState):
            raise TypeError(f"Invalid state: {value!r}")
        self.game.state = value

    # ------------------------------------------------------------------
    # Resources
    # ------------------------------------------------------------------

    @property
    def hp(self) -> int: return self.game.hp

    @hp.setter
    def hp(self, value: int) -> None:
        self.game.hp = max(0, min(value, self.max_hp))

    @property
    def max_hp(self) -> int: return self.game.max_hp

    @max_hp.setter
    def max_hp(self, value: int) -> None:
        self.game.max_hp = max(1, value)
        if self.hp > self.max_hp:
            self.game.hp = self.max_hp

    @property
    def mana(self) -> int: return self.game.mana

    @mana.setter
    def mana(self, value: int) -> None:
        self.game.mana = max(0, min(value, self.max_mana))

    @property
    def max_mana(self) -> int: return self.game.max_mana

    @max_mana.setter
    def max_mana(self, value: int) -> None:
        self.game.max_mana = max(1, value)
        if self.mana > self.max_mana:
            self.game.mana = self.max_mana

    @property
    def stamina(self) -> int: return self.game.stamina

    @stamina.setter
    def stamina(self, value: int) -> None:
        self.game.stamina = max(0, min(value, self.max_stamina))

    @property
    def max_stamina(self) -> int: return self.game.max_stamina

    @max_stamina.setter
    def max_stamina(self, value: int) -> None:
        self.game.max_stamina = max(1, value)
        if self.stamina > self.max_stamina:
            self.game.stamina = self.max_stamina

    def heal(self, amount: int) -> int:
        result = self.game.heal(amount)
        self.save()
        return result

    def take_damage(self, amount: int) -> bool:
        killed = self.game.take_damage(amount)
        self.save()
        return killed

    def restore_mana(self, amount: int) -> int:
        result = self.game.restore_mana(amount)
        self.save()
        return result

    def restore_stamina(self, amount: int) -> int:
        result = self.game.restore_stamina(amount)
        self.save()
        return result

    def is_alive(self) -> bool:
        return self.game.is_alive()

    # ------------------------------------------------------------------
    # Death / Respawn
    # ------------------------------------------------------------------

    def die(self) -> None:
        """Authoritative death — delegates to data-layer ``CharacterData.die()``.

        All death paths (combat, commands, environment) MUST route through
        this single method.  It sets state=DEAD and hp=0 via the unified
        data-layer API, then persists.
        """
        self.game.die()
        self.save()

    def respawn(self, xp_toward_next: int | None = None) -> None:
        """Restore to respawn state and apply death XP penalty.

        The XP penalty is 5% of progress toward the NEXT level.
        XP is clamped at the current level's threshold so death
        can NEVER cause a level loss.
        """
        if xp_toward_next is None:
            xp_toward_next = self.xp_progress()
        if xp_toward_next > 0:
            penalty = self.game.calc_death_xp_penalty(xp_toward_next)
            threshold = self.current_level_threshold()
            self.game.xp = max(threshold, self.game.xp - penalty)
        self.game.respawn_restore()
        self.save()

    # ------------------------------------------------------------------
    # Combat — Evennia integration layer for world/data/combat.py
    # ------------------------------------------------------------------

    def attack_target(self, target: "Character") -> dict:
        """Execute a combat attack against another Character.

        Wraps ``resolve_attack()`` from ``world.data.combat`` and ensures:

        * PvP eligibility is checked before the attack when both attacker
          and target are player characters.
        * Death always routes through ``Character.die()`` — the single
          authoritative death lifecycle.
        * PvP kills are recorded using faction-based eligibility.
        * Both attacker and target are persisted after the attack.
        * The result dict is returned for command-layer use.

        Args:
            target: Another Character instance to attack.

        Returns:
            The result dict from ``resolve_attack()`` (see combat.py docs).
            May include a "pvp_blocked" key with an error message when
            PvP is not allowed.
        """
        from world.data.combat import resolve_attack, record_pvp_kill, is_pvp_eligible
        from world.data.enums import PvPMode

        # ---- PvP eligibility check (player-vs-player only) -----------
        target_is_player = hasattr(target, 'has_account') and target.has_account
        attacker_is_player = hasattr(self, 'has_account') and self.has_account
        room_pvp_mode = PvPMode.SAFE
        both_players = attacker_is_player and target_is_player

        if both_players:
            room = self.location
            if room is not None and hasattr(room, 'pvp_mode'):
                room_pvp_mode = room.pvp_mode

            if not is_pvp_eligible(self.game, target.game, room_pvp_mode):
                return {
                    "valid": False,
                    "error": "PvP is not allowed in this area.",
                    "hit": False,
                    "roll": None,
                    "raw_damage": None,
                    "actual_damage": 0,
                    "target_hp_before": 0,
                    "target_hp_after": 0,
                    "target_killed": False,
                    "attacker_combat": False,
                    "target_combat": False,
                    "pvp_blocked": True,
                }

        result = resolve_attack(self.game, target.game)

        if result["target_killed"]:
            # Route through the authoritative death lifecycle.
            target.die()

            # Record PvP statistics (only for player-vs-player kills).
            if both_players:
                record_pvp_kill(self.game, target.game, room_pvp_mode)

        else:
            target.save()

        self.save()
        return result

