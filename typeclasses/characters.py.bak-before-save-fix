    # ------------------------------------------------------------------
    # Skills / Proficiencies (storage — Phase 3 does the granting)
    # ------------------------------------------------------------------

    @property
    def unlocked_skills(self) -> set: return self.game.unlocked_skills

    @property
    def proficiencies(self) -> dict: return self.game.proficiencies

    def set_proficiency(self, skill_id: str, value: int) -> None:
        self.game.proficiencies[skill_id] = value

    def get_proficiency(self, skill_id: str) -> int:
        return self.game.proficiencies.get(skill_id, 0)

    def has_skill(self, skill_id: str) -> bool:
        return skill_id in self.game.unlocked_skills

    # ------------------------------------------------------------------
    # Regeneration — periodic HP / Mana / Stamina recovery
    # ------------------------------------------------------------------

    _REGEN_IDSTRING = "rop_regen"

    def _regen_tick_callback(self) -> None:
        """Called by the TickerHandler every REGENERATION_TICK_SECONDS."""
        regen_tick(self.game)
        self.save()

    def start_regeneration(self) -> bool:
        """
        Start periodic resource regeneration.

        Idempotent: if a regeneration ticker is already subscribed for this
        character, returns False without creating a duplicate.

        Returns True if a new ticker was started; False if one was already
        running.
        """
        try:
            from evennia import TICKER_HANDLER
        except ImportError:
            return False  # not in a server environment
        if self.regeneration_active():
            return False
        TICKER_HANDLER.add(
            interval=REGENERATION_TICK_SECONDS,
            callback=self._regen_tick_callback,
            idstring=self._REGEN_IDSTRING,
            persistent=True,
        )
        return True

    def stop_regeneration(self) -> bool:
        """
        Stop periodic resource regeneration.

        Returns True if a ticker was stopped; False if none was running.
        """
        try:
            from evennia import TICKER_HANDLER
        except ImportError:
            return False  # not in a server environment
        if not self.regeneration_active():
            return False
        try:
            TICKER_HANDLER.remove(
                interval=REGENERATION_TICK_SECONDS,
                callback=self._regen_tick_callback,
                idstring=self._REGEN_IDSTRING,
            )
            return True
        except KeyError:
            return False

    def regeneration_active(self) -> bool:
        """Check whether a regeneration ticker is currently subscribed."""
        try:
            from evennia import TICKER_HANDLER
        except ImportError:
            return False
        store_key = TICKER_HANDLER._store_key(
            self, None,
            REGENERATION_TICK_SECONDS,
            "_regen_tick_callback",
            self._REGEN_IDSTRING,
            True,
        )
        return store_key in TICKER_HANDLER.ticker_storage

    # ------------------------------------------------------------------
    # Migration — detect / handle legacy characters
    # ------------------------------------------------------------------

    @classmethod
    def needs_migration(cls, character) -> bool:
        return not character.attributes.has(GAME_DATA_ATTR)

    def migrate(self) -> None:
        """Idempotent: create empty game data without overwriting."""
        if not self.attributes.has(GAME_DATA_ATTR):
            self._init_game_data()

    # ------------------------------------------------------------------
    # Hooks — keep data consistent across server lifecycle
    # ------------------------------------------------------------------

    def at_post_puppet(self, **kwargs):
        super().at_post_puppet(**kwargs)
        _ = self.game  # trigger lazy load

        # Phase 18 — First-puppet starting experience.
        # Idempotent: only runs once per character lifetime.
        try:
            from world.starting_experience import handle_first_puppet
            handle_first_puppet(self)
        except Exception:
            pass  # Never break puppeting for tutorial failure.

    def at_pre_unpuppet(self, **kwargs):
        self.save()
        super().at_pre_unpuppet(**kwargs)

    def at_server_reload(self):
        self.save()
        super().at_server_reload()

    def at_server_shutdown(self):
        self.save()
        super().at_server_shutdown()
