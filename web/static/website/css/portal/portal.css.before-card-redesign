   CHARACTER CREATION — WIZARD SYSTEM  (.rop-chargen-*)
   Authoritative flow: name → faction → race → profession → stats → review
   ======================================================================== */

/* ---- Progress Indicator ---- */
.rop-chargen__progress {
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}
.rop-chargen__progress-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}
.rop-chargen__step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.3rem;
  min-width: 0;
}
.rop-chargen__step-number {
  width: 32px; height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-family: var(--rop-font-display);
  font-size: 0.7rem;
  font-weight: 700;
