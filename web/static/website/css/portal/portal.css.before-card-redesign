  font-weight: 700;
  font-size: 1.1rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  margin: 0 0 0.65rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(160,136,72,0.15);
}

.rop-start-section__body p {
  color: #d6d8d9;
  line-height: 1.7;
