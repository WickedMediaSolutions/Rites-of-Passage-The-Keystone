.rop-lore-next__label {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.72rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
}
.rop-lore-next__desc {
  font-size: 0.82rem;
  color: var(--rop-text-muted);
  line-height: 1.35;
}

/* ---- LORE RESPONSIVE ---- */
@media(max-width:1024px){
  .rop-lore-marches-grid{grid-template-columns:repeat(3,1fr)}
