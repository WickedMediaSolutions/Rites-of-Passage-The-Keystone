  gap: 1rem;
}
.rop-dashboard-cc--wide {
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
}

/* ---- Command Center Tile ---- */
.rop-dashboard-cc__tile {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 1.1rem 1rem 1rem;
  background: linear-gradient(180deg, var(--rop-stone-deep) 0%, var(--rop-charcoal) 100%);
  border: 1px solid #30363b;
  box-shadow:
    0 0 0 2px #090b0d,
    0 0 0 3px rgba(160,136,72,0.35),
    0 0 0 5px #111417,
    0 6px 20px rgba(0,0,0,0.6),
    inset 0 0 0 1px rgba(205,170,86,0.1),
    inset 0 0 12px rgba(0,0,0,0.4);
  text-decoration: none !important;
  transition: all var(--rop-tr);
  cursor: pointer;
  min-height: 140px;
  justify-content: space-between;
}
.rop-dashboard-cc__tile::before {
  content: '';
  position: absolute;
  inset: 4px;
  border: 1px solid rgba(160,136,72,0.18);
  box-shadow:
    inset 0 0 0 1px rgba(0,0,0,0.65),
    0 0 0 1px rgba(70,76,82,0.28);
  pointer-events: none;
  z-index: 2;
}
.rop-dashboard-cc__tile::after {
  content: '';
  position: absolute;
  left: 14px;
  right: 14px;
  top: 6px;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(198,165,82,0.22) 15%,
    rgba(198,165,82,0.42) 50%,
    rgba(198,165,82,0.22) 85%,
    transparent
  );
  pointer-events: none;
  z-index: 2;
}
.rop-dashboard-cc__tile:hover {
  border-color: #4a5056;
  transform: translateY(-2px);
  box-shadow:
    0 0 0 2px #090b0d,
    0 0 0 3px rgba(160,136,72,0.5),
    0 0 0 5px #111417,
    0 8px 28px rgba(0,0,0,0.75),
    inset 0 0 0 1px rgba(205,170,86,0.18),
    inset 0 0 16px rgba(0,0,0,0.5);
}
a.rop-dashboard-cc__tile,
a.rop-dashboard-cc__tile:hover,
a.rop-dashboard-cc__tile:visited {
  color: inherit;
}

.rop-dashboard-cc__tile-header {
  position: relative;
  z-index: 3;
}
.rop-dashboard-cc__tile-icon {
  font-family: var(--rop-font-display);
  font-size: 1.5rem;
  line-height: 1;
  color: var(--rop-gold-light);
  margin-bottom: 0.4rem;
