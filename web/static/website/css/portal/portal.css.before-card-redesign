  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--rop-text-muted);
  white-space: nowrap;
}
.rop-chargen__step--current .rop-chargen__step-label {
  color: var(--rop-gold-light);
}
.rop-chargen__step-connector {
  flex: 1;
  height: 2px;
  min-width: 1rem;
  max-width: 3rem;
  background: var(--rop-steel-border);
  margin: 0 0.2rem;
  margin-bottom: 1.3rem;
}

/* ---- Card Grid (race + profession selection) ---- */
.rop-chargen__card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.85rem;
}
.rop-chargen__card-grid--profession {
  grid-template-columns: repeat(3, 1fr);
}

/* ---- Chargen Card ---- */
.rop-chargen__card {
  display: block;
  cursor: pointer;
  position: relative;
}
.rop-chargen__card-radio {
  position: absolute;
  opacity: 0;
  width: 0; height: 0;
  pointer-events: none;
}
.rop-chargen__card-inner {
  display: flex;
  flex-direction: row;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, var(--rop-stone-deep) 0%, var(--rop-charcoal) 100%);
  border: 2px solid var(--rop-steel-border);
  border-radius: var(--rop-radius);
  transition: all var(--rop-tr);
  height: 100%;
}
.rop-chargen__card:hover .rop-chargen__card-inner {
  border-color: #555;
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.5);
}
.rop-chargen__card-radio:focus-visible + .rop-chargen__card-inner {
  outline: 2px solid var(--rop-gold);
  outline-offset: 2px;
}
.rop-chargen__card-radio:checked + .rop-chargen__card-inner {
  border-color: var(--rop-gold-light);
  box-shadow:
    0 0 0 2px rgba(184,153,74,0.2),
    0 4px 20px rgba(0,0,0,0.6);
}
.rop-chargen__card-image {
  width: 100px;
  min-width: 100px;
  line-height: 0;
  border-right: 1px solid var(--rop-steel-border);
  border-bottom: 0;
  overflow: hidden;
  background: var(--rop-void);
}
.rop-chargen__card-image img {
  display: block;
  width: 100px;
  height: 100%;
  min-height: 110px;
  object-fit: cover;
  object-position: center top;
}
.rop-chargen__card-body {
  padding: 0.7rem 0.8rem;
  flex: 1;
  min-width: 0;
}
.rop-chargen__card-title {
  display: block;
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.78rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  margin-bottom: 0.25rem;
}
.rop-chargen__card-stats {
  display: block;
  font-family: var(--rop-font-display);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--rop-text-muted);
  margin-bottom: 0.3rem;
}
.rop-chargen__card-traits {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
}
.rop-chargen__card-subtitle {
  display: block;
  font-size: 0.78rem;
  color: var(--rop-text-muted);
  font-style: italic;
}

/* ---- Faction Selection Panels ---- */
.rop-chargen__faction-outer {
  max-width: 960px;
  margin: 0 auto;
}
.rop-chargen__faction-form {
  text-align: center;
}
.rop-chargen__faction-heading {
  font-family: var(--rop-font-display);
  font-size: 1.3rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--rop-text-heading);
  margin-bottom: 0.5rem;
}
.rop-chargen__faction-intro {
  font-size: 0.95rem;
  color: var(--rop-text-muted);
  margin-bottom: 1.5rem;
}
.rop-chargen__faction-panels {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}
.rop-chargen__faction-panel {
  display: block;
  cursor: pointer;
}
.rop-chargen__faction-radio {
  position: absolute;
  opacity: 0;
  width: 0; height: 0;
  pointer-events: none;
}
.rop-chargen__faction-panel-inner {
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  background: var(--rop-charcoal);
  border: 2px solid var(--rop-steel-border);
  border-radius: var(--rop-radius);
  transition: all var(--rop-tr);
  height: 100%;
}
.rop-chargen__faction-panel:hover .rop-chargen__faction-panel-inner {
  border-color: #555;
}
.rop-chargen__faction-panel--good .rop-chargen__faction-panel-inner {
  border-color: rgba(70,110,160,0.25);
}
.rop-chargen__faction-panel--evil .rop-chargen__faction-panel-inner {
  border-color: rgba(160,40,30,0.25);
}
.rop-chargen__faction-panel--good .rop-chargen__faction-radio:checked + .rop-chargen__faction-panel-inner {
  border-color: var(--rop-steel-blue-light);
  box-shadow: 0 0 20px rgba(90,128,176,0.2);
}
.rop-chargen__faction-panel--evil .rop-chargen__faction-radio:checked + .rop-chargen__faction-panel-inner {
  border-color: var(--rop-crimson-light);
  box-shadow: 0 0 20px rgba(184,40,32,0.2);
}
.rop-chargen__faction-radio:focus-visible + .rop-chargen__faction-panel-inner {
  outline: 2px solid var(--rop-gold);
  outline-offset: 2px;
}
.rop-chargen__faction-panel-art {
  line-height: 0;
  border-bottom: 1px solid var(--rop-steel-border);
  overflow: hidden;
  position: relative;
}
.rop-chargen__faction-panel-art img {
  display: block;
  width: 100%;
  height: auto;
}
.rop-chargen__faction-panel-body {
  padding: 1rem 1rem 1.2rem;
  flex: 1;
}
.rop-chargen__faction-panel-name {
  display: block;
  font-family: var(--rop-font-display);
  font-weight: 800;
  font-size: 1.1rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 0.35rem;
}
.rop-chargen__faction-panel-name--good {
  color: var(--rop-steel-blue-light);
}
.rop-chargen__faction-panel-name--evil {
  color: #d88070;
}
.rop-chargen__faction-panel-desc {
  display: block;
  font-size: 0.88rem;
  color: var(--rop-text-muted);
  margin-bottom: 0.8rem;
  line-height: 1.5;
}
.rop-chargen__faction-panel-select {
  display: inline-block;
  font-size: 0.68rem !important;
  padding: 0.4rem 1rem !important;
}

/* ---- Faction Banner (race page) ---- */
.rop-chargen__faction-banner {
  text-align: center;
  padding: 0.5rem 1rem;
  border: 1px solid var(--rop-steel-border);
  background: var(--rop-charcoal);
}
.rop-chargen__faction-banner--good {
  border-color: rgba(70,110,160,0.2);
}
.rop-chargen__faction-banner--evil {
  border-color: rgba(160,40,30,0.2);
}
.rop-chargen__faction-banner-label {
  font-family: var(--rop-font-display);
  font-size: 0.65rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--rop-text-muted);
  margin-right: 0.5rem;
}
.rop-chargen__faction-banner-name {
  font-family: var(--rop-font-display);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.rop-chargen__faction-banner--good .rop-chargen__faction-banner-name {
  color: var(--rop-steel-blue-light);
}
.rop-chargen__faction-banner--evil .rop-chargen__faction-banner-name {
  color: #d88070;
}

/* ---- Summary (race/profession/stats page) ---- */
.rop-chargen__summary {
  text-align: center;
  font-size: 0.88rem;
  color: var(--rop-text-muted);
  padding: 0.5rem 0.75rem;
  background: rgba(0,0,0,0.2);
  border: 1px solid rgba(255,255,255,0.03);
}
.rop-chargen__summary strong {
  color: var(--rop-text-bright);
}

/* ---- Roll Indicator ---- */
.rop-chargen__roll-indicator {
  text-align: center;
}
.rop-chargen__roll-badge {
  display: inline-block;
  font-family: var(--rop-font-display);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.5rem 1.2rem;
  color: var(--rop-gold-light);
  background: rgba(184,153,74,0.08);
  border: 1px solid rgba(184,153,74,0.2);
}
.rop-chargen__roll-badge--final {
  color: #d88070;
  background: rgba(184,40,32,0.06);
  border-color: rgba(184,40,32,0.2);
}

/* ---- Stat Grid ---- */
.rop-chargen__stat-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0.5rem;
  max-width: 640px;
  margin-left: auto;
  margin-right: auto;
}
.rop-chargen__stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0.75rem 0.4rem;
  background: rgba(0,0,0,0.2);
  border: 1px solid rgba(255,255,255,0.03);
  transition: all var(--rop-tr);
}
.rop-chargen__stat-item:hover {
  background: rgba(0,0,0,0.3);
  border-color: rgba(184,153,74,0.15);
}
.rop-chargen__stat-label {
  font-family: var(--rop-font-display);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--rop-text-muted);
  margin-bottom: 0.15rem;
}
.rop-chargen__stat-value {
  font-family: var(--rop-font-display);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--rop-text-bright);
  line-height: 1.2;
  margin-bottom: 0.1rem;
}
.rop-chargen__stat-name {
  font-size: 0.62rem;
  color: var(--rop-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

/* ---- Stat Actions ---- */
.rop-chargen__stat-actions {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

/* ---- Review Grid ---- */
.rop-chargen__review-banner {
  text-align: center;
  padding: 0.75rem 1rem;
  border: 1px solid;
  background: rgba(0,0,0,0.2);
}
.rop-chargen__review-banner--good {
  border-color: rgba(70,110,160,0.2);
  background: rgba(70,110,160,0.04);
}
.rop-chargen__review-banner--evil {
  border-color: rgba(160,40,30,0.2);
  background: rgba(160,40,30,0.04);
}
.rop-chargen__review-banner-text {
  font-family: var(--rop-font-display);
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.rop-chargen__review-banner--good .rop-chargen__review-banner-text {
  color: var(--rop-steel-blue-light);
}
.rop-chargen__review-banner--evil .rop-chargen__review-banner-text {
  color: #d88070;
}
.rop-chargen__review-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
}
.rop-chargen__review-item {
  padding: 0.65rem 0.85rem;
  background: rgba(0,0,0,0.2);
  border: 1px solid rgba(255,255,255,0.03);
}
.rop-chargen__review-label {
  display: block;
  font-family: var(--rop-font-display);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--rop-text-muted);
  margin-bottom: 0.3rem;
}
.rop-chargen__review-value {
  font-size: 0.95rem;
  color: var(--rop-text-bright);
  font-weight: 500;
}
.rop-chargen__review-value--name {
  font-family: var(--rop-font-display);
  font-size: 1.1rem;
  color: var(--rop-gold-light);
  font-weight: 700;
}
.rop-chargen__review-value--good {
  color: var(--rop-steel-blue-light);
  font-family: var(--rop-font-display);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.rop-chargen__review-value--evil {
  color: #d88070;
  font-family: var(--rop-font-display);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* ---- Chargen Responsive ---- */
@media(max-width:768px){
  .rop-chargen__faction-panels {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .rop-chargen__faction-panel-art {
    max-height: 150px;
  }
}
@media(max-width:1200px){
  .rop-chargen__card-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .rop-chargen__card-grid--profession {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media(max-width:900px){
  .rop-chargen__card-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .rop-chargen__card-grid--profession {
    grid-template-columns: repeat(2, 1fr);
  }
  .rop-chargen__stat-grid {
    grid-template-columns: repeat(5, 1fr);
  }
}
@media(max-width:600px){
  .rop-chargen__card-grid,
  .rop-chargen__card-grid--profession {
    grid-template-columns: 1fr;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }
  .rop-chargen__progress-steps {
    flex-wrap: wrap;
  }
  .rop-chargen__step-label {
    display: none;
  }
  .rop-chargen__step-connector {
    min-width: 0.5rem;
    max-width: 1.5rem;
  }
  .rop-chargen__stat-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .rop-chargen__stat-item:nth-child(4),
  .rop-chargen__stat-item:nth-child(5) {
    grid-column: span 1;
  }
  .rop-chargen__review-grid {
    grid-template-columns: 1fr;
  }
}
@media(max-width:400px){
  .rop-chargen__stat-grid {
    grid-template-columns: 1fr 1fr;
  }
  .rop-chargen__stat-item:last-child {
    grid-column: 1 / -1;
  }
}
