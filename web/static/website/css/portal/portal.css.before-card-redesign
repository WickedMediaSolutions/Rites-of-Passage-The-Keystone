  background: var(--rop-charcoal);
  border: 2px solid var(--rop-steel-border);
  transition: all var(--rop-tr);
}
.rop-chargen__step--current .rop-chargen__step-number {
  color: var(--rop-gold-light);
  background: var(--rop-charcoal);
  border-color: var(--rop-gold);
  box-shadow: 0 0 8px rgba(184,153,74,0.3);
}
.rop-chargen__step-label {
  font-family: var(--rop-font-display);
  font-size: 0.6rem;
