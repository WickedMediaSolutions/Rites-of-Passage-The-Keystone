}
.rop-guide-faction-duo__name--valroian { color: var(--rop-steel-blue-light); }
.rop-guide-faction-duo__name--mordrath { color: #d88070; }

/* ---- PvP Zone Table ---- */
.rop-guide-table {
  width: 100%;
  border-collapse: collapse;
  margin: 0.5rem 0 0.85rem;
  font-size: 0.9rem;
  border: 1px solid var(--rop-steel-border);
}
.rop-guide-table thead th {
  font-family: var(--rop-font-display);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  padding: 0.5rem 0.75rem;
  text-align: left;
  background: rgba(0,0,0,0.3);
  border-bottom: 1px solid var(--rop-steel-border);
}
.rop-guide-table tbody td {
  padding: 0.5rem 0.75rem;
  color: #d6d8d9;
  border-bottom: 1px solid rgba(255,255,255,0.03);
  vertical-align: top;
}
.rop-guide-table__zone {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.72rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  white-space: nowrap;
  width: 1px;
}
.rop-guide-table__zone--safe { color: #70b870; }
.rop-guide-table__zone--contested { color: #d88070; }

/* ---- Command Reference Rows ---- */
.rop-guide-cmd-cat {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.82rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #c8a85b;
  margin: 0.85rem 0 0.35rem;
  padding: 0.45rem 0.75rem;
  background: rgba(0,0,0,0.15);
  border-left: 3px solid rgba(160,136,72,0.3);
}
.rop-guide-cmd-ref {
  border: 1px solid rgba(160,136,72,0.1);
  margin-bottom: 0.5rem;
}
.rop-guide-cmd-ref__row {
  display: flex;
  gap: 0.75rem;
  padding: 0.5rem 0.75rem;
  border-bottom: 1px solid rgba(255,255,255,0.03);
  align-items: baseline;
}
.rop-guide-cmd-ref__row:last-child { border-bottom: none; }
.rop-guide-cmd-ref__cmd {
  flex-shrink: 0;
  min-width: 180px;
  font-family: "SF Mono", "Consolas", "Monaco", monospace;
  font-size: 0.88rem;
  color: var(--rop-gold-light);
  background: rgba(0,0,0,0.3);
  padding: 0.1em 0.5em;
  border: 1px solid rgba(160,136,72,0.16);
  border-radius: 2px;
  white-space: nowrap;
}
.rop-guide-cmd-ref__desc {
  font-size: 0.92rem;
  color: #d6d8d9;
  line-height: 1.5;
}
.rop-guide-cmd-ref__desc code {
  font-family: "SF Mono", "Consolas", "Monaco", monospace;
  font-size: 0.85rem;
  background: rgba(0,0,0,0.3);
  padding: 0.1em 0.35em;
  border-radius: 2px;
  color: var(--rop-gold-light);
}

/* ---- Command Search ---- */
.rop-guide-search { margin: 0.6rem 0 1rem; }
.rop-guide-search__label {
  display: block;
  font-family: var(--rop-font-display);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--rop-text-heading);
  margin-bottom: 0.3rem;
}
.rop-guide-search__input { font-family: var(--rop-font-body); }

/* ---- RESPONSIVE ---- */
@media(min-width:768px){
  .rop-nav__brand-text{display:inline}
}
@media(max-width:1024px){
  .rop-grid--4{grid-template-columns:repeat(3,1fr)}
  .rop-start-next{grid-template-columns:repeat(2,1fr)}
  .rop-guide-nav{width:180px}
  .rop-guide-cmd-grid--4{grid-template-columns:repeat(2,1fr)}
  .rop-guide-slot-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:768px){
  .rop-grid--2,.rop-grid--3,.rop-grid--4{grid-template-columns:1fr}
  .rop-grid--auto{grid-template-columns:1fr}
  .rop-faction-split{grid-template-columns:1fr}
  .rop-nav__toggle{display:block}
  .rop-nav__links{display:none;width:100%;flex-direction:column;gap:0}
  .rop-nav__links.open{display:flex}
  .rop-nav__links a{padding:0.5rem 0;border-bottom:1px solid var(--rop-steel-border)}
  .rop-nav{flex-wrap:wrap}
  .rop-hero__overlay{padding:1.5rem 1rem}
  .rop-hero__logo{max-width:300px}
  .rop-hero__tagline{font-size:0.8rem}
  .rop-container{padding:0 1rem}
  .rop-panel__inner{padding:0.75rem 0.9rem}
  .rop-panel__corner{width:32px;height:32px}

  .rop-start-masthead__frame img{max-height:260px}
  .rop-start-masthead__overlay{padding:1.75rem 1rem 1rem}
  .rop-start-masthead__title{font-size:1.3rem}
  .rop-start-masthead__subtitle{font-size:0.9rem}
  .rop-start-section{flex-direction:column}
  .rop-start-section__marker{width:100%;flex-direction:row;align-items:center;justify-content:flex-start;padding:0.55rem 1rem;font-size:1.2rem;border-right:none;border-bottom:1px solid rgba(160,136,72,0.12)}
  .rop-start-section__body{padding:0.85rem 1rem 1rem}
  .rop-start-next{grid-template-columns:1fr}
  .rop-start-cmd-table{font-size:0.85rem}
  .rop-start-cmd-table th,.rop-start-cmd-table td{padding:0.35rem 0.5rem}
  .rop-start-intro{padding:1rem 0 0.25rem}

  /* Game Guide responsive */
  .rop-guide-layout{flex-direction:column}
  .rop-guide-nav{width:100%;margin-right:0;margin-bottom:1rem;border-top:1px solid var(--rop-steel-border)}
  .rop-guide-nav__sticky{position:static;padding:0.5rem 0}
  .rop-guide-nav__list{display:flex;flex-wrap:wrap;gap:0.25rem;padding:0 0.75rem}
  .rop-guide-nav__link{font-size:0.62rem;padding:0.3rem 0.5rem;border-left:none;border-bottom:2px solid transparent}
  .rop-guide-nav__link:hover{border-left-color:transparent;border-bottom-color:rgba(160,136,72,0.4)}
  .rop-guide-nav__heading{padding:0.5rem 0.75rem 0.4rem}
  .rop-guide-masthead__frame img{max-height:240px}
  .rop-guide-masthead__overlay{padding:1.5rem 1rem 1rem}
  .rop-guide-masthead__title{font-size:1.3rem}
  .rop-guide-masthead__subtitle{font-size:0.9rem}
  .rop-guide-section{flex-direction:column}
  .rop-guide-section__marker{width:100%;flex-direction:row;align-items:center;justify-content:flex-start;padding:0.55rem 1rem;font-size:1.2rem;border-right:none;border-bottom:1px solid rgba(160,136,72,0.12)}
  .rop-guide-section__body{padding:0.85rem 1rem 1rem}
  .rop-guide-cmd-grid{grid-template-columns:1fr 1fr}
  .rop-guide-cmd-grid--4{grid-template-columns:repeat(2,1fr)}
  .rop-guide-slot-grid{grid-template-columns:repeat(3,1fr)}
  .rop-guide-faction-duo{grid-template-columns:1fr}
  .rop-guide-cmd-ref__row{flex-direction:column;gap:0.2rem}
  .rop-guide-cmd-ref__cmd{min-width:0;white-space:normal}
}

/* ========================================================================
   LORE & WORLD — Codex (.rop-lore-*)
   ======================================================================== */

/* ---- Masthead ---- */
.rop-lore-masthead {
  position: relative;
  overflow: hidden;
  margin-bottom: 0;
  background: var(--rop-void);
  border: 1px solid var(--rop-steel-border);
  border-bottom: none;
}
.rop-lore-masthead__frame {
  position: relative;
  line-height: 0;
  border: 4px solid var(--rop-charcoal);
  box-shadow: inset 0 0 0 1px rgba(160,136,72,0.08),
              0 0 0 1px rgba(0,0,0,0.5);
}
.rop-lore-masthead__frame img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 350px;
  object-fit: cover;
  object-position: center 40%;
}
.rop-lore-masthead__overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 2.5rem 2rem 1.5rem;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(5,6,7,0.45) 35%,
    rgba(5,6,7,0.92) 100%
  );
  z-index: 2;
}
.rop-lore-masthead__title {
  font-family: var(--rop-font-display);
  font-weight: 800;
  font-size: 2rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  text-shadow: 0 2px 12px rgba(0,0,0,0.9);
  margin: 0 0 0.3rem;
  line-height: 1.2;
}
.rop-lore-masthead__subtitle {
  font-family: var(--rop-font-body);
  font-weight: 400;
  font-size: 1.15rem;
  color: #d4d6d8;
  text-shadow: 0 1px 5px rgba(0,0,0,0.75);
  margin: 0;
  max-width: 620px;
  line-height: 1.45;
}

/* ---- Table of Contents ---- */
.rop-lore-toc {
  padding: 1.2rem 0 0;
  text-align: center;
}
.rop-lore-toc__heading {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  margin-bottom: 0.7rem;
}
.rop-lore-toc__links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
  justify-content: center;
}
.rop-lore-toc__link {
  display: inline-block;
  font-family: var(--rop-font-display);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--rop-text-muted);
  text-decoration: none;
  padding: 0.35rem 0.65rem;
  border: 1px solid rgba(160,136,72,0.12);
  transition: color var(--rop-tr), border-color var(--rop-tr), background var(--rop-tr);
}
.rop-lore-toc__link:hover {
  color: var(--rop-gold-light);
  border-color: rgba(160,136,72,0.35);
  background: rgba(160,136,72,0.06);
}

/* ---- Codex Sections ---- */
.rop-lore-section {
  display: flex;
  gap: 0;
  margin-bottom: 0;
  background:
    linear-gradient(180deg, var(--rop-stone-mid) 0%, var(--rop-stone-deep) 40%, var(--rop-charcoal) 100%);
  border: 1px solid var(--rop-steel-border);
  box-shadow:
    0 0 0 3px #090b0d,
    0 0 0 4px rgba(160,136,72,0.32),
    0 0 0 6px #111417,
    0 8px 28px rgba(0,0,0,0.78),
    inset 0 0 0 1px rgba(205,170,86,0.1),
    inset 0 0 18px rgba(0,0,0,0.5);
  border-top: none;
}
.rop-lore-section:first-of-type { border-top: 1px solid var(--rop-steel-border); }
.rop-lore-section + .rop-lore-section { margin-top: 1px; }
.rop-lore-section__numeral {
  flex-shrink: 0;
  width: 80px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 1.5rem 0 0 0;
  font-family: var(--rop-font-display);
  font-weight: 800;
  font-size: 2rem;
  letter-spacing: 0.04em;
  color: rgba(184,153,74,0.14);
  background: linear-gradient(180deg, rgba(184,153,74,0.05) 0%, transparent 100%);
  border-right: 1px solid rgba(160,136,72,0.1);
  user-select: none;
}
.rop-lore-section__numeral--valroian { color: rgba(90,128,176,0.16); }
.rop-lore-section__numeral--mordrath { color: rgba(184,100,90,0.16); }
.rop-lore-section__body {
  flex: 1;
  min-width: 0;
  padding: 1.5rem 2rem 1.75rem;
}
.rop-lore-section__heading {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 1.15rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #c8a85b;
  margin: 0 0 0.85rem;
  padding-bottom: 0.55rem;
  border-bottom: 1px solid rgba(160,136,72,0.18);
}
.rop-lore-section__heading--valroian { color: var(--rop-steel-blue-light); }
.rop-lore-section__heading--mordrath { color: #d88070; }
.rop-lore-section__body h3 {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #c8a85b;
  margin: 1.25rem 0 0.45rem;
}
.rop-lore-section__body p {
  font-size: 1.02rem;
  color: #d6d8d9;
  line-height: 1.7;
  margin-bottom: 0.65rem;
}
.rop-lore-dropcap {
  font-size: 1.12rem !important;
  color: #e0e1e2 !important;
}

/* ---- Pillars ---- */
.rop-lore-pillars {
  display: flex;
  gap: 1px;
  margin: 0.75rem 0 1rem;
  background: var(--rop-steel-border);
  border: 1px solid var(--rop-steel-border);
}
.rop-lore-pillar {
  flex: 1;
  padding: 0.75rem 0.6rem;
  text-align: center;
  background: rgba(0,0,0,0.25);
}
.rop-lore-pillar__word {
  display: block;
  font-family: var(--rop-font-display);
  font-weight: 800;
  font-size: 0.9rem;
  letter-spacing: 0.12em;
  margin-bottom: 0.2rem;
}
.rop-lore-pillar__desc {
  display: block;
  font-family: var(--rop-font-body);
  font-size: 0.75rem;
  font-style: italic;
  color: var(--rop-text-muted);
}
.rop-lore-pillar--valroian .rop-lore-pillar__word { color: var(--rop-steel-blue-light); }
.rop-lore-pillar--mordrath .rop-lore-pillar__word { color: #d88070; }

/* ---- Callout Boxes ---- */
.rop-lore-callout {
  padding: 0.75rem 1.25rem;
  margin: 0.75rem 0 1rem;
  background: rgba(0,0,0,0.25);
  border-left: 3px solid rgba(160,136,72,0.3);
}
.rop-lore-callout p { font-size: 0.98rem !important; color: #c8c9cb !important; margin-bottom: 0.3rem !important; }
.rop-lore-callout--subtle { border-left-color: rgba(160,136,72,0.15); background: rgba(0,0,0,0.15); }

/* ---- Pull Quotes ---- */
.rop-lore-quote {
  position: relative;
  padding: 1rem 1.25rem 0.5rem 2.5rem;
  margin: 1rem 0;
  background: rgba(0,0,0,0.18);
  border-left: 3px solid rgba(184,153,74,0.25);
}
.rop-lore-quote--player { border-left-color: rgba(139,26,20,0.2); }
.rop-lore-quote__mark {
  position: absolute;
  left: 0.6rem;
  top: 0.15rem;
  font-family: var(--rop-font-display);
  font-size: 3rem;
  line-height: 1;
  color: rgba(184,153,74,0.15);
  pointer-events: none;
}
.rop-lore-quote__text {
  font-family: var(--rop-font-body);
  font-weight: 400;
  font-style: italic;
  font-size: 1.05rem !important;
  color: #dbddde !important;
  line-height: 1.55 !important;
}

/* ---- Sect Cards ---- */
.rop-lore-sect {
  margin: 1rem 0;
  border: 1px solid rgba(160,136,72,0.12);
  background: rgba(0,0,0,0.18);
}
.rop-lore-sect--dominant {
  border-color: rgba(184,100,90,0.25);
  background: rgba(139,26,20,0.04);
}
.rop-lore-sect__header {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  background: rgba(0,0,0,0.2);
  border-bottom: 1px solid rgba(255,255,255,0.03);
}
.rop-lore-sect__icon {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  color: var(--rop-gold-light);
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(160,136,72,0.2);
}
.rop-lore-sect--mordrath .rop-lore-sect__icon { color: #d88070; border-color: rgba(184,100,90,0.25); }
.rop-lore-sect--valroian .rop-lore-sect__icon { color: var(--rop-steel-blue-light); border-color: rgba(90,128,176,0.25); }
.rop-lore-sect__titles { flex: 1; min-width: 0; }
.rop-lore-sect__name {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.82rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #c8a85b;
  margin: 0 0 0.15rem;
}
.rop-lore-sect--mordrath .rop-lore-sect__name { color: #d88070; }
.rop-lore-sect--valroian .rop-lore-sect__name { color: var(--rop-steel-blue-light); }
.rop-lore-sect__role {
  display: block;
  font-family: var(--rop-font-display);
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--rop-text-muted);
}
.rop-lore-sect__badge {
  display: inline-block;
  margin-top: 0.2rem;
  font-family: var(--rop-font-display);
  font-size: 0.55rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  padding: 0.1rem 0.45rem;
  background: rgba(184,40,32,0.15);
  border: 1px solid rgba(184,100,90,0.25);
  color: #d88070;
}
.rop-lore-sect__body { padding: 0.75rem 1rem 0.85rem; }
.rop-lore-sect__body p { font-size: 0.95rem !important; line-height: 1.6 !important; margin-bottom: 0.5rem !important; }

/* ---- Sayings ---- */
.rop-lore-saying {
  display: flex;
  gap: 0.4rem;
  align-items: flex-start;
  margin: 0.6rem 0 0.25rem;
  padding: 0.45rem 0;
  border-top: 1px solid rgba(255,255,255,0.03);
}
.rop-lore-saying__mark {
  flex-shrink: 0;
  font-family: var(--rop-font-display);
  font-size: 1.6rem;
  line-height: 1;
  color: rgba(184,153,74,0.2);
}
.rop-lore-sect--mordrath .rop-lore-saying__mark { color: rgba(184,100,90,0.18); }
.rop-lore-saying__text {
  font-family: var(--rop-font-body);
  font-style: italic;
  font-size: 0.95rem;
  color: #c5c6c8;
  padding-top: 0.2rem;
}

/* ---- Marches Grid ---- */
.rop-lore-marches-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1px;
  margin: 0.6rem 0 0.85rem;
  background: var(--rop-steel-border);
  border: 1px solid var(--rop-steel-border);
}
.rop-lore-marches-grid__item {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  padding: 0.55rem 0.6rem;
  background: rgba(0,0,0,0.25);
}
.rop-lore-marches-grid__label {
  font-family: var(--rop-font-display);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
}
.rop-lore-marches-grid__desc {
  font-size: 0.78rem;
  color: var(--rop-text-muted);
  line-height: 1.35;
}

/* ---- PvP Callout ---- */
.rop-lore-pvp-callout {
  margin: 1rem 0 0.5rem;
  padding: 0.85rem 1rem;
  background: rgba(0,0,0,0.2);
  border: 1px solid rgba(160,136,72,0.15);
}
.rop-lore-pvp-callout__header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--rop-font-display);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  margin-bottom: 0.6rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.rop-lore-pvp-callout__icon { font-size: 1rem; }
.rop-lore-pvp-callout__rules {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
}
.rop-lore-pvp-callout__rule {
  padding: 0.5rem 0.65rem;
  border: 1px solid;
  font-size: 0.82rem;
  line-height: 1.4;
}
.rop-lore-pvp-callout__rule strong { display: block; margin-bottom: 0.15rem; }
.rop-lore-pvp-callout__rule--safe {
  background: rgba(50,140,50,0.05);
  border-color: rgba(50,140,50,0.15);
  color: #b0d0b0;
}
.rop-lore-pvp-callout__rule--contested {
  background: rgba(184,100,60,0.05);
  border-color: rgba(184,100,60,0.18);
  color: #e0b8a8;
}
.rop-lore-pvp-callout__note {
  font-size: 0.82rem !important;
  color: var(--rop-text-muted) !important;
  line-height: 1.4 !important;
}

/* ---- Faith Grid ---- */
.rop-lore-faith-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  margin: 0.6rem 0 0.8rem;
  background: var(--rop-steel-border);
  border: 1px solid var(--rop-steel-border);
}
.rop-lore-faith-grid__item {
  padding: 0.6rem 0.8rem;
  background: rgba(0,0,0,0.2);
}
.rop-lore-faith-grid__item p { font-size: 0.9rem !important; margin-bottom: 0 !important; font-style: italic; }

/* ---- Life List ---- */
.rop-lore-life-list { margin: 0.5rem 0 0.75rem; }
.rop-lore-life-list p {
  padding: 0.35rem 0 0.35rem 1.5rem;
  margin-bottom: 0 !important;
  border-left: 2px solid rgba(160,136,72,0.15);
  font-size: 0.95rem !important;
}

/* ---- Age Signs ---- */
.rop-lore-age-signs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  margin: 0.75rem 0 0.85rem;
  background: var(--rop-steel-border);
  border: 1px solid var(--rop-steel-border);
}
.rop-lore-age-sign {
  padding: 0.75rem 1rem;
  background: rgba(0,0,0,0.2);
}
.rop-lore-age-sign__label {
  display: block;
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 0.35rem;
}
.rop-lore-age-sign--valroian .rop-lore-age-sign__label { color: var(--rop-steel-blue-light); }
.rop-lore-age-sign--mordrath .rop-lore-age-sign__label { color: #d88070; }
.rop-lore-age-sign__text { font-size: 0.9rem; color: #c5c6c8; line-height: 1.5; }

/* ---- Closing & Next Steps ---- */
.rop-lore-closing { text-align: center; margin: 1.25rem 0 0.5rem; }
.rop-lore-closing p {
  font-family: var(--rop-font-display);
  font-weight: 700;
