}
.rop-start-section:first-of-type {
  border-top: 1px solid var(--rop-steel-border);
}
.rop-start-section + .rop-start-section {
  margin-top: 1px;
}

.rop-start-section__marker {
  flex-shrink: 0;
  width: 72px;
