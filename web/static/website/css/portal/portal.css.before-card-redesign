  .rop-lore-section__body{padding:0.85rem 1rem 1rem}
  .rop-lore-section__heading{font-size:1rem}
  .rop-lore-section__body p{font-size:0.92rem}
  .rop-lore-pillars{flex-direction:column}
  .rop-lore-marches-grid{grid-template-columns:repeat(2,1fr)}
