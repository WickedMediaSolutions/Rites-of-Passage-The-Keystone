  border-right: 1px solid var(--rop-steel-border);
  border-bottom: 1px solid var(--rop-steel-border);
}
.rop-start-divider img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 36px;
  object-fit: contain;
  opacity: 0.55;
}

/* ---- Introduction ---- */
.rop-start-intro {
  padding: 1.75rem 0 0.5rem;
  text-align: center;
}
.rop-start-intro p {
  font-size: 1.08rem;
  color: #d4d6d8;
  max-width: 680px;
  margin: 0 auto;
  line-height: 1.6;
}

/* ---- Guide Section ---- */
.rop-start-section {
  position: relative;
  display: flex;
  gap: 0;
  margin-bottom: 0;
  background:
    linear-gradient(180deg, var(--rop-stone-mid) 0%, var(--rop-stone-deep) 40%, var(--rop-charcoal) 100%);
  border: 1px solid var(--rop-steel-border);
