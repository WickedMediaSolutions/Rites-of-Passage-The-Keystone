/* ========================================================================
   NEWS & UPDATES — .rop-news-*
   ======================================================================== */

/* ---- Cinematic Masthead ---- */
.rop-news-masthead {
  position: relative;
  overflow: hidden;
  margin-bottom: 0;
  background: var(--rop-void);
  border: 1px solid var(--rop-steel-border);
  border-bottom: none;
}
.rop-news-masthead__frame {
  position: relative;
  line-height: 0;
  border: 4px solid var(--rop-charcoal);
  box-shadow: inset 0 0 0 1px rgba(160,136,72,0.08),
              0 0 0 1px rgba(0,0,0,0.5);
}
.rop-news-masthead__frame img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 320px;
  object-fit: cover;
  object-position: center 35%;
}
.rop-news-masthead__overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 2.2rem 2rem 1.4rem;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(5,6,7,0.5) 35%,
    rgba(5,6,7,0.92) 100%
  );
  z-index: 2;
}
.rop-news-masthead__title {
  font-family: var(--rop-font-display);
  font-weight: 800;
  font-size: 1.8rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  text-shadow: 0 2px 10px rgba(0,0,0,0.85);
  margin: 0 0 0.25rem;
  line-height: 1.2;
}
.rop-news-masthead__subtitle {
  font-family: var(--rop-font-body);
  font-weight: 400;
  font-size: 1.05rem;
  color: #d4d6d8;
  text-shadow: 0 1px 5px rgba(0,0,0,0.75);
  margin: 0;
  max-width: 580px;
  line-height: 1.45;
}

/* ---- Anchor Nav ---- */
.rop-news-nav {
  display: flex;
  gap: 0;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
  background:
    linear-gradient(180deg, var(--rop-stone-mid) 0%, var(--rop-stone-deep) 100%);
  border: 1px solid var(--rop-steel-border);
  border-top: none;
  box-shadow:
    0 0 0 3px #090b0d,
    0 0 0 4px rgba(160,136,72,0.35),
    0 0 0 6px #111417;
}
.rop-news-nav__link {
  font-family: var(--rop-font-display);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--rop-text-muted);
  text-decoration: none;
  padding: 0.6rem 1.2rem;
  border-right: 1px solid rgba(255,255,255,0.04);
  transition: color var(--rop-tr), background var(--rop-tr);
}
.rop-news-nav__link:hover,
.rop-news-nav__link--active {
  color: var(--rop-gold-light);
  background: rgba(160,136,72,0.06);
}
.rop-news-nav__link--active {
  border-bottom: 2px solid var(--rop-crimson);
}

/* ---- News Badge ---- */
.rop-news-badge {
  display: inline-block;
  font-family: var(--rop-font-display);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.15rem 0.55rem;
  border: 1px solid rgba(160,136,72,0.25);
  color: var(--rop-gold-light);
  background: rgba(160,136,72,0.06);
  white-space: nowrap;
}
.rop-news-badge--crimson {
  border-color: rgba(180,40,30,0.35);
  color: #d88070;
  background: rgba(139,26,20,0.1);
}
.rop-news-badge--steel {
  border-color: rgba(90,128,176,0.3);
  color: var(--rop-steel-blue-light);
  background: rgba(90,128,176,0.06);
}

/* ---- FEATURED STORY ---- */
.rop-news-featured {
  position: relative;
  margin-bottom: 1.5rem;
  background:
    linear-gradient(180deg, var(--rop-stone-mid) 0%, var(--rop-stone-deep) 30%, var(--rop-charcoal) 100%);
  border: 1px solid var(--rop-steel-border);
  box-shadow:
    0 0 0 3px #090b0d,
    0 0 0 4px rgba(180,40,30,0.28),
    0 0 0 6px #111417,
    0 8px 32px rgba(0,0,0,0.78),
    inset 0 0 0 1px rgba(200,70,50,0.10),
    inset 0 0 24px rgba(0,0,0,0.5);
}
/* Featured corner brackets */
.rop-news-featured__bracket {
  position: absolute;
  width: 24px; height: 24px;
  pointer-events: none;
  z-index: 2;
}
.rop-news-featured__bracket--tl {
  top: 6px; left: 6px;
  border-top: 2px solid rgba(200,70,50,0.4);
  border-left: 2px solid rgba(200,70,50,0.4);
}
.rop-news-featured__bracket--tr {
  top: 6px; right: 6px;
  border-top: 2px solid rgba(200,70,50,0.4);
  border-right: 2px solid rgba(200,70,50,0.4);
}
.rop-news-featured__bracket--bl {
  bottom: 6px; left: 6px;
  border-bottom: 2px solid rgba(200,70,50,0.4);
  border-left: 2px solid rgba(200,70,50,0.4);
}
.rop-news-featured__bracket--br {
  bottom: 6px; right: 6px;
  border-bottom: 2px solid rgba(200,70,50,0.4);
  border-right: 2px solid rgba(200,70,50,0.4);
}
.rop-news-featured__header {
  padding: 2rem 2.5rem 0;
}
.rop-news-featured__meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 0.75rem;
}
.rop-news-featured__date {
  font-family: var(--rop-font-display);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--rop-text-muted);
}
.rop-news-featured__title {
  font-family: var(--rop-font-display);
  font-weight: 800;
  font-size: 1.5rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #c8a85b;
  margin: 0 0 0.25rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(200,70,50,0.18);
  line-height: 1.25;
}
.rop-news-featured__body {
  padding: 1.5rem 2.5rem 2rem;
}
.rop-news-featured__body p {
  font-size: 1.02rem;
  color: #d6d8d9;
  line-height: 1.7;
  margin-bottom: 0.75rem;
}
.rop-news-dropcap {
  font-size: 1.12rem !important;
  color: #e0e1e2 !important;
}
.rop-news-featured__closing {
  font-size: 1.05rem !important;
  color: #c8a85b !important;
  margin-top: 1rem !important;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(160,136,72,0.12);
}

/* Featured highlights grid */
.rop-news-featured__highlights {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  margin: 0.85rem 0 1rem;
  background: var(--rop-steel-border);
  border: 1px solid var(--rop-steel-border);
}
.rop-news-highlight {
  padding: 0.6rem 0.85rem;
  background: rgba(0,0,0,0.25);
}
.rop-news-highlight__label {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  margin-bottom: 0.15rem;
}
.rop-news-highlight__detail {
  font-size: 0.85rem;
  color: #b0b2b4;
  line-height: 1.45;
}
.rop-news-featured__rail {
  height: 3px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(200,70,50,0.25) 20%,
    rgba(200,70,50,0.25) 80%,
    transparent 100%
  );
}

/* ---- NEXUS ANNOUNCEMENT ---- */
.rop-news-nexus {
  position: relative;
  margin-bottom: 1.5rem;
  background:
    linear-gradient(180deg, var(--rop-stone-mid) 0%, var(--rop-stone-deep) 30%, var(--rop-charcoal) 100%);
  border: 1px solid var(--rop-steel-border);
  box-shadow:
    0 0 0 3px #090b0d,
    0 0 0 4px rgba(90,128,176,0.22),
    0 0 0 6px #111417,
    0 8px 28px rgba(0,0,0,0.78),
    inset 0 0 0 1px rgba(90,128,176,0.08),
    inset 0 0 18px rgba(0,0,0,0.5);
}
.rop-news-nexus__accent {
  position: absolute;
  top: 0; left: 0;
  width: 3px; height: 100%;
  background: linear-gradient(
    180deg,
    rgba(90,128,176,0.5) 0%,
    rgba(90,128,176,0.15) 100%
  );
  pointer-events: none;
}
.rop-news-nexus__header {
  padding: 1.75rem 2rem 0;
}
.rop-news-nexus__meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 0.6rem;
}
.rop-news-nexus__date {
  font-family: var(--rop-font-display);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--rop-text-muted);
}
.rop-news-nexus__title {
  font-family: var(--rop-font-display);
  font-weight: 800;
  font-size: 1.2rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--rop-steel-blue-light);
  margin: 0 0 0.25rem;
  padding-bottom: 0.6rem;
  border-bottom: 1px solid rgba(90,128,176,0.15);
  line-height: 1.3;
}
.rop-news-nexus__body {
  padding: 1.25rem 2rem 1.75rem;
}
.rop-news-nexus__body p {
  font-size: 1.02rem;
  color: #d6d8d9;
  line-height: 1.7;
  margin-bottom: 0.65rem;
}
/* ---- ARCHIVE HEADER ---- */
.rop-news-archive-header {
  text-align: center;
  margin-bottom: 1.25rem;
  padding: 1rem 1.5rem;
  background:
    linear-gradient(180deg, var(--rop-stone-mid) 0%, var(--rop-charcoal) 100%);
  border: 1px solid var(--rop-steel-border);
  box-shadow:
    0 0 0 3px #090b0d,
    0 0 0 4px rgba(160,136,72,0.3),
    0 0 0 6px #111417;
}
.rop-news-archive-header__title {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 1.1rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  margin: 0 0 0.3rem;
}
.rop-news-archive-header__subtitle {
  font-size: 0.95rem;
  color: var(--rop-text-muted);
  margin: 0;
}

/* ---- TIMELINE ---- */
.rop-news-timeline {
  position: relative;
}

/* ---- ARCHIVE ENTRY ---- */
.rop-news-entry {
  display: flex;
  gap: 0;
  margin-bottom: 0;
  background:
    linear-gradient(180deg, var(--rop-stone-mid) 0%, var(--rop-stone-deep) 40%, var(--rop-charcoal) 100%);
  border: 1px solid var(--rop-steel-border);
  box-shadow:
    0 0 0 3px #090b0d,
    0 0 0 4px rgba(160,136,72,0.35),
    0 0 0 6px #111417,
    0 8px 28px rgba(0,0,0,0.78),
    inset 0 0 0 1px rgba(205,170,86,0.12),
    inset 0 0 18px rgba(0,0,0,0.5);
  border-top: none;
}
.rop-news-entry:first-of-type {
  border-top: 1px solid var(--rop-steel-border);
}
.rop-news-entry + .rop-news-entry {
  margin-top: 1px;
}

/* Marker (date column) */
.rop-news-entry__marker {
  flex-shrink: 0;
  width: 85px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 1.25rem 0 0 0;
  background:
    linear-gradient(180deg, rgba(184,153,74,0.06) 0%, transparent 100%);
  border-right: 1px solid rgba(160,136,72,0.12);
  position: relative;
}
.rop-news-entry__date {
  text-align: center;
  line-height: 1.15;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.rop-news-entry__day {
  font-family: var(--rop-font-display);
  font-weight: 800;
  font-size: 1.7rem;
  color: rgba(184,153,74,0.22);
  display: block;
}
.rop-news-entry__month {
  font-family: var(--rop-font-display);
  font-weight: 600;
  font-size: 0.62rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--rop-text-muted);
  display: block;
}
.rop-news-entry__year {
  font-family: var(--rop-font-display);
  font-weight: 600;
  font-size: 0.55rem;
  letter-spacing: 0.08em;
  color: rgba(160,136,72,0.35);
  display: block;
}
.rop-news-entry__rail {
  flex: 1;
  width: 2px;
  min-height: 1.5rem;
  background: linear-gradient(
    180deg,
    rgba(160,136,72,0.15) 0%,
    transparent 100%
  );
  margin-top: 0.5rem;
}

/* Entry body */
.rop-news-entry__body {
  flex: 1;
  min-width: 0;
  padding: 1.25rem 1.5rem 1.5rem;
}
.rop-news-entry__meta {
  margin-bottom: 0.4rem;
}
.rop-news-entry__title {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: #c8a85b;
  margin: 0 0 0.65rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid rgba(160,136,72,0.14);
}
.rop-news-entry__content p {
  font-size: 0.95rem;
  color: #d6d8d9;
  line-height: 1.65;
  margin-bottom: 0.55rem;
}
.rop-news-entry__content p:last-child {
  margin-bottom: 0;
}
.rop-news-entry__link {
  display: inline-block;
  font-family: var(--rop-font-display);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  text-decoration: none;
  margin-top: 0.25rem;
  transition: color var(--rop-tr);
}
.rop-news-entry__link:hover {
  color: #d5b96d;
}

/* ---- DEVELOPMENT STATUS ---- */
.rop-news-status {
  position: relative;
  margin-bottom: 2rem;
  background:
    linear-gradient(180deg, var(--rop-stone-mid) 0%, var(--rop-stone-deep) 40%, var(--rop-charcoal) 100%);
  border: 1px solid var(--rop-steel-border);
  box-shadow:
    0 0 0 3px #090b0d,
    0 0 0 4px rgba(160,136,72,0.35),
    0 0 0 6px #111417,
    0 8px 28px rgba(0,0,0,0.78),
    inset 0 0 0 1px rgba(205,170,86,0.12),
    inset 0 0 18px rgba(0,0,0,0.5);
}
.rop-news-status__header {
  padding: 1.25rem 2rem 0;
  text-align: center;
}
.rop-news-status__title {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: #c8a85b;
  margin: 0 0 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid rgba(160,136,72,0.18);
}
.rop-news-status__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1px;
  background: var(--rop-steel-border);
  margin: 0 1.5rem 1.5rem;
  border: 1px solid var(--rop-steel-border);
}
.rop-news-status__item {
  padding: 0.75rem 1rem;
  background: rgba(0,0,0,0.25);
  border-left: 3px solid transparent;
}
.rop-news-status__item--complete {
  border-left-color: rgba(50,140,50,0.35);
}
.rop-news-status__item--active {
  border-left-color: rgba(184,153,74,0.3);
}
.rop-news-status__item--steel {
  border-left-color: rgba(90,128,176,0.3);
}
.rop-news-status__item--ongoing {
  border-left-color: rgba(160,136,72,0.2);
}
.rop-news-status__label {
  font-family: var(--rop-font-display);
  font-weight: 700;
  font-size: 0.72rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--rop-gold-light);
  margin-bottom: 0.15rem;
}
.rop-news-status__state {
  font-family: var(--rop-font-display);
  font-weight: 600;
  font-size: 0.62rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 0.35rem;
}
.rop-news-status__item--complete .rop-news-status__state { color: #70b870; }
.rop-news-status__item--active .rop-news-status__state { color: #c8a85b; }
.rop-news-status__item--steel .rop-news-status__state { color: var(--rop-steel-blue-light); }
.rop-news-status__item--ongoing .rop-news-status__state { color: var(--rop-text-muted); }
.rop-news-status__desc {
  font-size: 0.82rem;
  color: var(--rop-text-muted);
  line-height: 1.45;
}

