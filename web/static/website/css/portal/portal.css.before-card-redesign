  gap: 0.45rem;
  font-size: 0.9rem;
  color: var(--rop-text-muted);
}
.rop-start-logged-in a {
  color: var(--rop-gold-light);
  text-decoration: underline;
}

/* ---- Callout / Warning ---- */
.rop-start-callout {
  margin-top: 0.75rem;
  padding: 0.65rem 0.9rem;
  border: 1px solid;
  font-size: 0.9rem;
  line-height: 1.55;
}
.rop-start-callout--warn {
  background: rgba(139,26,20,0.06);
  border-color: rgba(180,50,40,0.22);
  color: #d88070;
}
.rop-start-callout--warn strong {
  color: #e89080;
}

/* ---- Command Table ---- */
.rop-start-cmd-wrap {
  overflow-x: auto;
