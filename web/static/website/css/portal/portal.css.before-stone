/* ========================================================================
   RITES OF PASSAGE — COMPLETE PORTAL SYSTEM
   Palette: black / charcoal / grey stone / iron / weathered steel
   Gold = restrained aged accent only. Crimson = primary action.
   ======================================================================== */

/* ---- FONTS ---- */
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap');

/* ---- TOKENS ---- */
:root {
  --rop-black: #050607;
  --rop-abyss: #07080a;
  --rop-void: #0a0c0f;
  --rop-charcoal: #111418;
  --rop-stone-deep: #16191d;
  --rop-stone: #1c2024;
  --rop-stone-mid: #22262b;
  --rop-stone-raised: #272b30;
  --rop-stone-high: #2d3137;
  --rop-iron: #181b1e;
  --rop-iron-light: #20242a;
  --rop-steel: #2b3035;
  --rop-steel-border: #3a3f44;
  --rop-gold-dark: #5a4a2a;
  --rop-gold: #b8994a;
  --rop-gold-light: #c8a85b;
  --rop-gold-accent: rgba(184,153,74,0.25);
  --rop-crimson-dark: #3a0c08;
  --rop-crimson: #8b1a14;
  --rop-crimson-light: #b82820;
  --rop-steel-blue: #5a80b0;
  --rop-steel-blue-light: #6a90c0;
  --rop-text: #d4d6d8;
  --rop-text-heading: #d5b96d;
  --rop-text-bright: #e4e5e6;
  --rop-text-muted: #a09e96;
  --rop-text-link: #c8a85b;
  --rop-font-display: 'Cinzel','Times New Roman',Georgia,serif;
  --rop-font-body: 'Cormorant Garamond',Georgia,'Times New Roman',serif;
  --rop-radius: 2px;
  --rop-tr: 0.2s ease;
  --rop-shadow: 0 4px 24px rgba(0,0,0,0.6);
}

/* ---- RESET ---- */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px;scroll-behavior:smooth;-webkit-font-smoothing:antialiased}

/* ---- BODY — dark stone environment ---- */
body{
  background:
    radial-gradient(ellipse at 50% 0%, rgba(20,24,28,0.7) 0%, transparent 60%),
    radial-gradient(ellipse at 15% 50%, rgba(90,128,176,0.03) 0%, transparent 30%),
    radial-gradient(ellipse at 85% 50%, rgba(139,26,20,0.03) 0%, transparent 30%),
    var(--rop-black);
  background-attachment:fixed;
  color:var(--rop-text);
  font-family:var(--rop-font-body);
  font-weight:400;
  font-size:1.05rem;
  line-height:1.65;
  min-height:100vh;
}

/* ---- GLOBAL CONTAINER ---- */
.rop-wrap{
  max-width:1560px;
  margin:0 auto;
  position:relative;
}
.rop-container{
  width:100%;
  max-width:1480px;
  margin:0 auto;
  padding:0 1.5rem;
}

/* ---- TYPOGRAPHY ---- */
h1,h2,h3,h4,h5,h6{
  font-family:var(--rop-font-display);
  font-weight:700;
  color:var(--rop-text-heading);
  text-transform:uppercase;
  letter-spacing:0.06em;
  line-height:1.3;
  text-shadow:0 1px 4px rgba(0,0,0,0.6);
}
h1{font-size:1.6rem;letter-spacing:0.08em}
h2{font-size:1.2rem;letter-spacing:0.07em}
h3{font-size:0.95rem;letter-spacing:0.06em}
h4{font-size:0.82rem;letter-spacing:0.05em}
a{color:var(--rop-text-link);text-decoration:none;transition:color var(--rop-tr)}
a:hover{color:var(--rop-gold-light)}
a:focus-visible{outline:2px solid var(--rop-gold);outline-offset:2px}
p{margin-bottom:0.6rem}
small,.rop-muted{color:#b0b2b4;font-size:0.85rem}
.rop-lead{font-size:1.15rem;color:#d4d6d8}
code{font-family:monospace;background:rgba(0,0,0,0.3);padding:0.1em 0.35em;border-radius:2px;color:var(--rop-gold-light)}

/* ---- HEADER — fortress/cathedral structure ---- */
.rop-header{
  background:
    url('../images/ornate/dark-stone.png') repeat,
    linear-gradient(180deg,var(--rop-stone-mid) 0%,var(--rop-stone-deep) 50%,var(--rop-charcoal) 100%);
  border-top:3px solid var(--rop-steel-border);
  border-bottom:2px solid var(--rop-steel-border);
  box-shadow:0 4px 20px rgba(0,0,0,0.7);
  position:relative;z-index:100;
}
.rop-header::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--rop-gold-accent) 20%,var(--rop-gold-accent) 80%,transparent);
}
.rop-nav{
  display:flex;
  align-items:center;
  justify-content:space-between;
  max-width:1480px;
  margin:0 auto;
  padding:0.5rem 1.5rem;
  min-height:64px;
  gap:1rem;
  flex-wrap:wrap;
}
.rop-nav__brand{
  display:flex;
  align-items:center;
  gap:0.75rem;
  text-decoration:none !important;
  flex-shrink:0;
}
.rop-nav__brand img{
  height:48px;
  width:auto;
}
.rop-nav__brand-text{
  font-family:var(--rop-font-display);
  font-weight:800;
  font-size:1rem;
  letter-spacing:0.1em;
  color:var(--rop-gold-light);
  text-transform:uppercase;
  display:none;
}
.rop-nav__links{
  display:flex;
  align-items:center;
  gap:0.15rem;
  list-style:none;
  flex-wrap:wrap;
}
.rop-nav__links a{
  display:block;
  font-family:var(--rop-font-display);
  font-size:0.7rem;
  font-weight:600;
  letter-spacing:0.06em;
  text-transform:uppercase;
  color:var(--rop-text);
  text-decoration:none;
  padding:0.65rem 0.55rem;
  transition:color var(--rop-tr),background var(--rop-tr);
  border-radius:var(--rop-radius);
  white-space:nowrap;
}
.rop-nav__links a:hover,
.rop-nav__links a.active{
  color:var(--rop-gold-light);
  background:rgba(160,136,72,0.05);
}
.rop-nav__play{
  font-family:var(--rop-font-display) !important;
  font-weight:700 !important;
  font-size:0.68rem !important;
  letter-spacing:0.08em !important;
  color:#f0d8b0 !important;
  background:linear-gradient(180deg,var(--rop-crimson) 0%,var(--rop-crimson-dark) 100%) !important;
  border:1px solid rgba(180,60,40,0.3) !important;
  padding:0.5rem 1rem !important;
  box-shadow:inset 0 1px 0 rgba(220,100,60,0.2);
}
.rop-nav__play:hover{
  background:linear-gradient(180deg,var(--rop-crimson-light) 0%,var(--rop-crimson) 100%) !important;
  color:#fff !important;
}
.rop-nav__user{
  display:flex;
  align-items:center;
  gap:0.5rem;
  font-family:var(--rop-font-display);
  font-size:0.7rem;
  letter-spacing:0.04em;
}
.rop-nav__user a{
  color:var(--rop-text-muted);
  text-decoration:none;
  text-transform:uppercase;
  padding:0.4rem 0.5rem;
}
.rop-nav__user a:hover{color:var(--rop-gold-light)}
.rop-nav__toggle{
  display:none;
  background:none;
  border:1px solid var(--rop-steel-border);
  color:var(--rop-text);
  font-size:1.4rem;
  padding:0.3rem 0.6rem;
  cursor:pointer;
  border-radius:var(--rop-radius);
}

/* ---- PANEL — dark stone construction ---- */
.rop-panel{
  position:relative;
  margin-bottom:1.5rem;
  background:
    linear-gradient(180deg,var(--rop-stone-mid) 0%,var(--rop-stone-deep) 40%,var(--rop-charcoal) 100%);
  border:1px solid var(--rop-steel-border);
  box-shadow:var(--rop-shadow),inset 0 1px 0 rgba(255,255,255,0.015);
  overflow:hidden;
}
.rop-panel__rail{
  position:absolute;
  left:0;right:0;
  height:3px;
  z-index:2;
  pointer-events:none;
}
.rop-panel__rail--top{
  top:0;
  background:linear-gradient(90deg,transparent 3%,var(--rop-gold-accent) 20%,rgba(160,136,72,0.35) 50%,var(--rop-gold-accent) 80%,transparent 97%);
}
.rop-panel__rail--bottom{
  bottom:0;
  background:linear-gradient(90deg,transparent 5%,rgba(160,136,72,0.1) 20%,var(--rop-gold-accent) 50%,rgba(160,136,72,0.1) 80%,transparent 95%);
}
.rop-panel__inner{
  padding:1rem 1.25rem;
  position:relative;
}
.rop-panel__plaque{
  position:relative;
  padding:0.65rem 1rem 0.5rem;
  margin-bottom:0.75rem;
  text-align:center;
  border-bottom:1px solid var(--rop-steel-border);
}
.rop-panel__plaque::before{
  content:'';
  position:absolute;
  top:0;left:20%;right:20%;
  height:1px;
  background:linear-gradient(90deg,transparent,rgba(160,136,72,0.3),transparent);
}
.rop-panel__plaque h2,.rop-panel__plaque h3{
  margin:0;
  color:#c8a85b;
  font-size:0.82rem;
  letter-spacing:0.1em;
  text-shadow:0 1px 3px rgba(0,0,0,0.5);
}
.rop-panel__corners{
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:3;
}
.rop-panel__corner{
  position:absolute;
  width:48px;
  height:48px;
}
.rop-panel__corner--tl{top:0;left:0}
.rop-panel__corner--tr{top:0;right:0}
.rop-panel__corner--bl{bottom:0;left:0}
.rop-panel__corner--br{bottom:0;right:0}

/* ---- BUTTONS ---- */
.rop-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:0.4rem;
  font-family:var(--rop-font-display);
  font-weight:700;
  font-size:0.75rem;
  letter-spacing:0.08em;
  text-transform:uppercase;
  text-decoration:none !important;
  padding:0.55rem 1.2rem;
  border:none;
  cursor:pointer;
  transition:all var(--rop-tr);
  border-radius:var(--rop-radius);
}
.rop-btn--crimson{
  color:#e8dcc8;
  background:linear-gradient(180deg,var(--rop-crimson) 0%,var(--rop-crimson-dark) 100%);
  border:1px solid rgba(180,60,40,0.35);
  box-shadow:0 2px 8px rgba(0,0,0,0.5),inset 0 1px 0 rgba(220,100,60,0.2);
}
.rop-btn--crimson:hover{background:linear-gradient(180deg,var(--rop-crimson-light) 0%,var(--rop-crimson) 100%);color:#fff;border-color:rgba(200,70,50,0.45)}
.rop-btn--gold{
  color:#1a1408;
  background:linear-gradient(180deg,var(--rop-gold-light) 0%,var(--rop-gold-dark) 100%);
  border:1px solid rgba(180,150,80,0.4);
  box-shadow:0 2px 6px rgba(0,0,0,0.4),inset 0 1px 0 rgba(240,210,140,0.3);
}
.rop-btn--gold:hover{background:linear-gradient(180deg,#b89850 0%,var(--rop-gold-light) 100%)}
.rop-btn--iron{
  color:#d4d6d8;
  background:linear-gradient(180deg,var(--rop-iron-light) 0%,var(--rop-iron) 100%);
  border:1px solid var(--rop-steel-border);
  box-shadow:0 2px 6px rgba(0,0,0,0.4);
}
.rop-btn--iron:hover{color:#e4e5e6;border-color:#555}
.rop-btn--sm{font-size:0.65rem;padding:0.35rem 0.8rem}
.rop-btn--lg{font-size:0.85rem;padding:0.7rem 1.6rem}

/* ---- DIVIDER ---- */
.rop-divider{
  display:flex;
  align-items:center;
  gap:0.75rem;
  margin:2rem 0 1.5rem;
}
.rop-divider::before,.rop-divider::after{
  content:'';
  flex:1;
  height:1px;
  background:linear-gradient(90deg,transparent,var(--rop-steel-border) 40%,var(--rop-steel-border) 60%,transparent);
}
.rop-divider__icon{
  width:8px;
  height:8px;
  border:1.5px solid var(--rop-gold-accent);
  transform:rotate(45deg);
  flex-shrink:0;
}

/* ---- ART MOUNT ---- */
.rop-art{
  position:relative;
  overflow:hidden;
  margin-bottom:1.5rem;
}
.rop-art img{
  display:block;
  width:100%;
  height:auto;
}
.rop-art__frame{
  border:4px solid var(--rop-charcoal);
  box-shadow:inset 0 0 0 1px rgba(160,136,72,0.08),0 0 0 1px rgba(0,0,0,0.5);
  line-height:0;
}
.rop-art__shade{
  position:absolute;
  bottom:0;left:0;right:0;
  height:50%;
  background:linear-gradient(180deg,transparent 0%,rgba(5,6,7,0.45) 40%,rgba(5,6,7,0.82) 100%);
  pointer-events:none;
}

/* ---- COMPENDIUM CARD — for races/professions/armory ---- */
.rop-card{
  background:linear-gradient(180deg,var(--rop-stone-deep) 0%,var(--rop-charcoal) 100%);
  border:1px solid var(--rop-steel-border);
  box-shadow:var(--rop-shadow);
  transition:all var(--rop-tr);
}
.rop-card:hover{
  border-color:#555;
  transform:translateY(-2px);
  box-shadow:0 8px 30px rgba(0,0,0,0.7);
}
.rop-card a{text-decoration:none}
.rop-card__img{
  line-height:0;
  border-bottom:1px solid var(--rop-steel-border);
  overflow:hidden;
}
.rop-card__img img{
  display:block;
  width:100%;
  height:auto;
}
.rop-card__body{
  padding:0.6rem 0.75rem 0.75rem;
}
.rop-card__title{
  font-family:var(--rop-font-display);
  font-weight:700;
  font-size:0.8rem;
  letter-spacing:0.06em;
  text-transform:uppercase;
  color:#c8a85b;
  margin-bottom:0.2rem;
}
.rop-card__info{
  font-size:0.85rem;
  color:#b0b2b4;
  line-height:1.4;
}

/* ---- STAT ITEM ---- */
.rop-stat{
  display:flex;
  flex-direction:column;
  padding:0.35rem 0.55rem;
  background:rgba(0,0,0,0.2);
  border:1px solid rgba(255,255,255,0.03);
}
.rop-stat__label{
  font-family:var(--rop-font-display);
  font-size:0.62rem;
  font-weight:600;
  letter-spacing:0.05em;
  text-transform:uppercase;
  color:var(--rop-text-muted);
}
.rop-stat__value{
  font-size:0.95rem;
  font-weight:500;
  color:var(--rop-text-bright);
}

/* ---- BADGE ---- */
.rop-badge{
  display:inline-block;
  font-family:var(--rop-font-display);
  font-size:0.62rem;
  font-weight:600;
  letter-spacing:0.05em;
  text-transform:uppercase;
  padding:0.12rem 0.45rem;
  border:1px solid var(--rop-gold-accent);
  color:var(--rop-gold-light);
}
.rop-badge--crimson{border-color:rgba(180,40,30,0.3);color:#c87060}
.rop-badge--steel{border-color:rgba(90,128,176,0.25);color:var(--rop-steel-blue-light)}
.rop-badge--green{border-color:rgba(50,140,50,0.3);color:#70b870}

/* ---- GRIDS ---- */
.rop-grid{display:grid;gap:1rem}
.rop-grid--2{grid-template-columns:1fr 1fr}
.rop-grid--3{grid-template-columns:repeat(3,1fr)}
.rop-grid--4{grid-template-columns:repeat(4,1fr)}
.rop-grid--auto{grid-template-columns:repeat(auto-fill,minmax(240px,1fr))}

/* ---- HERO SECTION ---- */
.rop-hero{
  position:relative;
  overflow:hidden;
  margin-bottom:1.5rem;
  background:var(--rop-void);
}
.rop-hero__art{
  line-height:0;
}
.rop-hero__art img{
  display:block;
  width:100%;
  height:auto;
}
.rop-hero__overlay{
  position:absolute;
  bottom:0;left:0;right:0;
  padding:3rem 2rem 2rem;
  background:linear-gradient(180deg,transparent 0%,rgba(5,6,7,0.6) 30%,rgba(5,6,7,0.9) 100%);
  text-align:center;
}
.rop-hero__logo{
  max-width:500px;
  height:auto;
  margin:0 auto 1rem;
  display:block;
}
.rop-hero__tagline{
  font-family:var(--rop-font-display);
  font-weight:600;
  font-size:1rem;
  letter-spacing:0.1em;
  text-transform:uppercase;
  color:#c8a85b;
  text-shadow:0 1px 6px rgba(0,0,0,0.7);
  margin-bottom:0.5rem;
}
.rop-hero__copy{
  font-size:1.05rem;
  color:#d4d6d8;
  text-shadow:0 1px 4px rgba(0,0,0,0.7);
  max-width:600px;
  margin:0 auto 1rem;
}
.rop-hero__actions{
  display:flex;
  gap:0.75rem;
  justify-content:center;
  flex-wrap:wrap;
}

/* ---- FACTIONS SPLIT ---- */
.rop-faction-split{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:2px;
  background:var(--rop-steel-border);
}
.rop-faction-split__side{
  position:relative;
  overflow:hidden;
}
.rop-faction-split__art{
  line-height:0;
}
.rop-faction-split__art img{
  display:block;
  width:100%;
  height:auto;
}
.rop-faction-split__shade{
  position:absolute;
  inset:0;
  pointer-events:none;
}
.rop-faction-split__shade--valroian{
  background:linear-gradient(180deg,transparent 50%,rgba(5,10,20,0.85) 100%);
}
.rop-faction-split__shade--mordrath{
  background:linear-gradient(180deg,transparent 50%,rgba(20,5,5,0.85) 100%);
}
.rop-faction-split__info{
  position:absolute;
  bottom:0;left:0;right:0;
  padding:2rem 1.5rem 1.5rem;
  text-align:center;
  z-index:2;
}
.rop-faction-split__emblem{
  width:64px;
  height:64px;
  object-fit:contain;
  margin-bottom:0.5rem;
}
.rop-faction-split__name{
  font-family:var(--rop-font-display);
  font-weight:800;
  font-size:1.3rem;
  letter-spacing:0.1em;
  text-transform:uppercase;
  margin-bottom:0.3rem;
}
.rop-faction-split__name--valroian{color:var(--rop-steel-blue-light);text-shadow:0 1px 4px rgba(0,0,0,0.7)}
.rop-faction-split__name--mordrath{color:#d88070;text-shadow:0 1px 4px rgba(0,0,0,0.7)}
.rop-faction-split__desc{
  font-size:0.85rem;
  color:#d0d2d4;
  text-shadow:0 1px 4px rgba(0,0,0,0.8);
  margin-bottom:0.75rem;
}
.rop-faction-split__link{
  display:inline-block;
  font-family:var(--rop-font-display);
  font-size:0.68rem;
  font-weight:700;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:#f0d8b0;
  text-decoration:none;
  padding:0.45rem 1rem;
  background:linear-gradient(180deg,rgba(139,26,20,0.85),rgba(90,16,12,0.9));
  border:1px solid rgba(180,60,46,0.45);
  box-shadow:0 2px 8px rgba(0,0,0,0.5),inset 0 1px 0 rgba(220,100,60,0.2);
  transition:all var(--rop-tr);
}
.rop-faction-split__link:hover{
  background:linear-gradient(180deg,rgba(180,30,24,0.9),rgba(120,20,16,0.92));
  border-color:rgba(200,50,40,0.55);
  color:#ffe0c0;
  box-shadow:0 4px 14px rgba(0,0,0,0.6),inset 0 1px 0 rgba(220,80,50,0.3);
}

/* ---- SECTION CAP ---- */
.rop-cap{
  text-align:center;
  margin-bottom:0.75rem;
  font-family:var(--rop-font-display);
  font-size:0.65rem;
  letter-spacing:0.15em;
  text-transform:uppercase;
  color:var(--rop-text-muted);
}
.rop-cap::before,.rop-cap::after{
  content:' — ';
  color:var(--rop-steel-border);
}

/* ---- FORM ---- */
.rop-form-group{margin-bottom:0.85rem}
.rop-label{
  display:block;
  font-family:var(--rop-font-display);
  font-size:0.7rem;
  font-weight:600;
  letter-spacing:0.05em;
  text-transform:uppercase;
  color:var(--rop-text-heading);
  margin-bottom:0.3rem;
}
.rop-input{
  display:block;
  width:100%;
  font-family:var(--rop-font-body);
  font-size:0.95rem;
  color:var(--rop-text);
  background:var(--rop-charcoal);
  border:1px solid var(--rop-steel-border);
  padding:0.5rem 0.75rem;
  border-radius:var(--rop-radius);
  transition:border-color var(--rop-tr);
}
.rop-input:focus{
  outline:none;
  border-color:var(--rop-gold-light);
  box-shadow:0 0 0 2px rgba(160,136,72,0.1);
}
.rop-input::placeholder{color:var(--rop-text-muted)}
.rop-alert{
  padding:0.65rem 1rem;
  margin-bottom:0.85rem;
  border:1px solid;
  font-size:0.9rem;
}
.rop-alert--warning{
  background:rgba(139,34,34,0.06);
  border-color:rgba(180,60,50,0.2);
  color:#d88070;
}
.rop-alert--info{
  background:rgba(90,128,176,0.05);
  border-color:rgba(90,128,176,0.15);
  color:var(--rop-steel-blue-light);
}

/* ---- STATUS ---- */
.rop-status{display:inline-flex;align-items:center;gap:0.4rem}
.rop-status__dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.rop-status__dot--online{background:#50b850;box-shadow:0 0 6px rgba(80,184,80,0.4)}
.rop-status__dot--offline{background:#666}

/* ---- FOOTER ---- */
.rop-footer{
  margin-top:2rem;
  padding:1rem 0;
  text-align:center;
  border-top:2px solid var(--rop-steel-border);
  background:var(--rop-charcoal);
  font-family:var(--rop-font-display);
  font-size:0.65rem;
  letter-spacing:0.06em;
  text-transform:uppercase;
  color:var(--rop-text-muted);
}
.rop-footer::before{
  content:'';
  display:block;
  height:1px;
  margin-bottom:1rem;
  background:linear-gradient(90deg,transparent,var(--rop-gold-accent),transparent);
}

/* ---- CINEMATIC AUTH ---- */
.rop-auth-hero{
  position:relative;
  min-height:500px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--rop-void);
  margin-bottom:1.5rem;
}
.rop-auth-hero__bg{
  position:absolute;
  inset:0;
}
.rop-auth-hero__bg img{
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
}
.rop-auth-hero__shade{
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,rgba(5,6,7,0.6) 0%,rgba(5,6,7,0.75) 50%,rgba(5,6,7,0.95) 100%);
}
.rop-auth-hero__panel{
  position:relative;
  z-index:2;
  width:100%;
  max-width:460px;
  margin:1.5rem;
}

/* ---- RESPONSIVE ---- */
@media(min-width:768px){
  .rop-nav__brand-text{display:inline}
}
@media(max-width:1024px){
  .rop-grid--4{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:768px){
  .rop-grid--2,.rop-grid--3,.rop-grid--4{grid-template-columns:1fr}
  .rop-grid--auto{grid-template-columns:1fr}
  .rop-faction-split{grid-template-columns:1fr}
  .rop-nav__toggle{display:block}
  .rop-nav__links{display:none;width:100%;flex-direction:column;gap:0}
  .rop-nav__links.open{display:flex}
  .rop-nav__links a{padding:0.5rem 0;border-bottom:1px solid var(--rop-steel-border)}
  .rop-nav{flex-wrap:wrap}
  .rop-hero__overlay{padding:1.5rem 1rem}
  .rop-hero__logo{max-width:300px}
  .rop-hero__tagline{font-size:0.8rem}
  .rop-container{padding:0 1rem}
  .rop-panel__inner{padding:0.75rem 0.9rem}
  .rop-panel__corner{width:32px;height:32px}
}
