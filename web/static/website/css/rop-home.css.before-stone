/* ==========================================================================
   Rites of Passage — HOMEPAGE ORNATE STONE CSS
   Full A. ORNATE STONE visual reconstruction.
   ========================================================================== */

:root {
  --orn-void: #050404;
  --orn-abyss: #080706;
  --orn-black-stone: #0b0a08;
  --orn-stone-0: #0e0c09;
  --orn-stone-1: #12100c;
  --orn-stone-2: #171410;
  --orn-stone-3: #1c1813;
  --orn-stone-4: #221d16;
  --orn-stone-raised: #282218;
  --orn-iron: #1a1815;
  --orn-iron-light: #25221c;
  --orn-gold-dark: #5a3e1a;
  --orn-gold-mid: #7a5628;
  --orn-gold: #9d7134;
  --orn-gold-light: #b88a42;
  --orn-gold-pale: #d4aa60;
  --orn-gold-ivory: #e8cc88;
  --orn-bronze: #6a5030;
  --orn-bronze-light: #8a6a40;
  --orn-crimson-deep: #1a0605;
  --orn-crimson-dark: #4a100c;
  --orn-crimson: #8b1a14;
  --orn-crimson-light: #b82820;
  --orn-crimson-glow: #c84030;
  --orn-blue-deep: #081018;
  --orn-blue-dark: #142840;
  --orn-blue: #3a6090;
  --orn-blue-light: #5a80b0;
  --orn-parchment: #c8b898;
  --orn-parchment-dark: #a89870;
  --orn-text: #d4d6d8;
  --orn-text-heading: #d5b96d;
  --orn-text-bright: #e4e5e6;
  --orn-text-muted: #a09e96;
  --orn-gold-line: rgba(157,113,52,0.35);
  --orn-gold-line-weak: rgba(157,113,52,0.18);
  --orn-shadow-deep: 0 8px 40px rgba(0,0,0,0.7);
  --orn-shadow-panel: 0 4px 24px rgba(0,0,0,0.55);
  --orn-font-display: 'Cinzel','Times New Roman',Georgia,serif;
  --orn-font-body: 'Cormorant Garamond',Georgia,'Times New Roman',serif;
}

body {
  background: radial-gradient(ellipse at 50% 0%, rgba(40,28,14,0.18), transparent 55%),
              radial-gradient(ellipse at 5% 40%, rgba(58,96,144,0.04), transparent 30%),
              radial-gradient(ellipse at 95% 40%, rgba(139,26,20,0.04), transparent 30%),
              var(--orn-abyss) !important;
}
.rop-world-frame, #main-content { background: transparent !important; max-width: 1560px; }
.rop-container { max-width: 1480px; }

/* ==========================================================================
   3. GLOBAL HEADER — ORNATE STONE
   ========================================================================== */
.rop-header {
  position: relative; z-index: 50;
  background: linear-gradient(180deg, rgba(26,22,15,0.98), rgba(10,9,7,0.99)),
              repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.03) 3px, rgba(0,0,0,0.03) 6px),
              var(--orn-black-stone) !important;
  border-top: 2px solid var(--orn-gold-dark);
  border-bottom: 2px solid var(--orn-gold-mid);
  box-shadow: 0 1px 0 rgba(20,14,6,0.8) inset, 0 -1px 0 rgba(200,160,80,0.12) inset, 0 8px 32px rgba(0,0,0,0.75);
}
.rop-header::before, .rop-header::after {
  content: ""; position: absolute; left: 0; right: 0; height: 3px; pointer-events: none;
}
.rop-header::before {
  top: 5px;
  background: linear-gradient(90deg, transparent, rgba(157,113,52,0.2) 5%, rgba(200,150,70,0.4) 20%, rgba(180,130,50,0.5) 50%, rgba(200,150,70,0.4) 80%, rgba(157,113,52,0.2) 95%, transparent);
}
.rop-header::after {
  bottom: 5px;
  background: linear-gradient(90deg, transparent, rgba(157,113,52,0.15) 8%, rgba(180,130,50,0.3) 50%, rgba(157,113,52,0.15) 92%, transparent);
}
.rop-navbar { max-width: 1480px; min-height: 72px; margin: 0 auto; padding: 6px 24px !important; }
.rop-navbar-brand {
  display: flex !important; align-items: center; gap: 10px; min-width: 180px; margin-right: 28px !important; position: relative;
}
.rop-navbar-brand::after {
  content: ""; position: absolute; right: -14px; top: 8px; bottom: 8px; width: 1px;
  background: linear-gradient(180deg, transparent, var(--orn-gold-mid), transparent); opacity: 0.5;
}
.rop-navbar-brand .navbar-brand-logo {
  width: auto !important; height: 44px !important; max-width: 170px !important; margin: 0 !important;
  object-fit: contain; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
}
.rop-nav-brand-text { display: none !important; }
.rop-navbar .nav-link {
  position: relative; color: #c8b898 !important; font-family: var(--orn-font-display);
  font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
  padding: 1.6rem 0.7rem 1.35rem !important; transition: color 0.18s ease, text-shadow 0.18s ease;
}
.rop-navbar .nav-link:hover, .rop-navbar .nav-link:focus {
  color: #f0d89c !important; text-shadow: 0 0 12px rgba(200,150,70,0.25);
}
.rop-navbar .nav-link.active { color: #f0d89c !important; }
.rop-navbar .nav-link.active::after {
  content: ""; position: absolute; bottom: 8px; left: 0.7rem; right: 0.7rem; height: 2px;
  background: linear-gradient(90deg, transparent, var(--orn-crimson), transparent);
}
.rop-nav-play {
  color: #f0c8a0 !important;
  background: linear-gradient(180deg, rgba(139,26,20,0.3), rgba(139,26,20,0.08)) !important;
  border: 1px solid rgba(180,40,30,0.3); border-radius: 1px;
  margin: 0.55rem 0 0.55rem 0.4rem; padding: 0.45rem 1rem !important;
  box-shadow: inset 0 1px 0 rgba(200,60,40,0.2);
}
.rop-nav-play:hover {
  background: linear-gradient(180deg, rgba(180,30,24,0.5), rgba(139,26,20,0.2)) !important;
  border-color: rgba(200,50,40,0.5); color: #ffe0c0 !important;
}
.rop-navbar .dropdown-menu {
  background: var(--orn-stone-1); border: 1px solid var(--orn-gold-mid); border-radius: 1px;
  box-shadow: 0 8px 28px rgba(0,0,0,0.8);
}
.rop-navbar .dropdown-item {
  color: var(--orn-text); font-family: var(--orn-font-body); font-size: 0.9rem; padding: 0.5rem 1.2rem;
  transition: background 0.15s, color 0.15s;
}
.rop-navbar .dropdown-item:hover { background: rgba(157,113,52,0.12); color: var(--orn-gold-pale); }
.rop-navbar .dropdown-divider { border-color: var(--orn-gold-line-weak); }

/* ==========================================================================
   4. HOMEPAGE CONTAINER
   ========================================================================== */
.rop-homepage {
  width: 100%; overflow: hidden;
  background: radial-gradient(ellipse at 50% 20%, rgba(90,60,28,0.06), transparent 55%), var(--orn-abyss);
}

/* ==========================================================================
   5. HERO SECTION
   ========================================================================== */
.rop-home-hero { position: relative; width: 100%; min-height: 620px; max-height: 740px; overflow: hidden; background: var(--orn-void); }
.rop-home-hero__art {
  position: absolute; inset: 0;
  background: url('/static/website/images/home-hero.png') center 35% / cover no-repeat;
  z-index: 1;
}
.rop-home-hero__shade {
  position: absolute; inset: 0; z-index: 2;
  background: linear-gradient(180deg, rgba(5,4,3,0.55) 0%, rgba(5,4,3,0.15) 30%, rgba(5,4,3,0.05) 55%, rgba(5,4,3,0.6) 100%),
              radial-gradient(ellipse at 50% 50%, transparent 40%, rgba(5,4,3,0.5) 100%);
}
.rop-home-hero__frame {
  position: absolute; inset: 16px; z-index: 3;
  border: 2px solid rgba(157,113,52,0.3);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.5), 0 0 0 8px rgba(0,0,0,0.4), 0 0 0 9px rgba(157,113,52,0.15);
  pointer-events: none;
}

/* Ornate hero corners */
.rop-corner { position: absolute; width: 52px; height: 52px; pointer-events: none; z-index: 5; }
.rop-corner::before, .rop-corner::after {
  content: ""; position: absolute;
  background: linear-gradient(135deg, rgba(184,138,66,0.7), rgba(157,113,52,0.3));
  box-shadow: 0 0 6px rgba(200,150,70,0.2);
}
.rop-corner::before { width: 52px; height: 3px; }
.rop-corner::after { width: 3px; height: 52px; }
.rop-corner--tl { top: -2px; left: -2px; }
.rop-corner--tl::before { top: 0; left: 0; } .rop-corner--tl::after { top: 0; left: 0; }
.rop-corner--tr { top: -2px; right: -2px; }
.rop-corner--tr::before { top: 0; right: 0; } .rop-corner--tr::after { top: 0; right: 0; }
.rop-corner--bl { bottom: -2px; left: -2px; }
.rop-corner--bl::before { bottom: 0; left: 0; } .rop-corner--bl::after { bottom: 0; left: 0; }
.rop-corner--br { bottom: -2px; right: -2px; }
.rop-corner--br::before { bottom: 0; right: 0; } .rop-corner--br::after { bottom: 0; right: 0; }

/* Hero edge rails */
.rop-hero-rail {
  position: absolute; left: 8px; right: 8px; height: 4px; pointer-events: none; z-index: 4;
  background: linear-gradient(90deg, transparent, rgba(184,138,66,0.4) 10%, rgba(200,150,70,0.5) 50%, rgba(184,138,66,0.4) 90%, transparent);
}
.rop-hero-rail--top { top: 6px; }
.rop-hero-rail--bottom { bottom: 6px; }

.rop-home-hero__content {
  position: relative; z-index: 4; display: flex; flex-direction: column; align-items: center; justify-content: center;
  width: 100%; height: 100%; padding: 40px 32px 48px; pointer-events: auto;
}
.rop-home-hero__logo {
  max-width: 620px; max-height: 200px; width: auto; height: auto; object-fit: contain;
  filter: drop-shadow(0 4px 16px rgba(0,0,0,0.7)); margin-bottom: 18px;
}
.rop-home-hero__rule {
  display: flex; align-items: center; gap: 14px; width: 340px; max-width: 80%; margin-bottom: 18px;
}
.rop-home-hero__rule span { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(200,150,70,0.5), transparent); }
.rop-home-hero__rule i { width: 8px; height: 8px; background: rgba(200,150,70,0.7); transform: rotate(45deg); flex-shrink: 0; }
.rop-home-hero__tagline {
  font-family: var(--orn-font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--orn-gold-pale); text-shadow: 0 2px 8px rgba(0,0,0,0.8); margin: 0 0 6px;
}
.rop-home-hero__lede {
  font-family: var(--orn-font-body); font-size: 1.05rem; font-style: italic; color: var(--orn-text);
  text-shadow: 0 1px 4px rgba(0,0,0,0.8); margin: 0 0 24px;
}
.rop-home-hero__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

/* ==========================================================================
   6. ORNATE BUTTONS (HERO)
   ========================================================================== */
.rop-home-btn {
  display: inline-flex; align-items: center; justify-content: center;
  font-family: var(--orn-font-display); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; text-decoration: none !important;
  padding: 12px 28px; min-width: 160px; position: relative;
  transition: all 0.2s ease; cursor: pointer; border: 2px solid transparent; outline: none;
}
.rop-home-btn--crimson {
  background: linear-gradient(180deg, rgba(139,26,20,0.85), rgba(90,16,12,0.9));
  border-color: rgba(180,40,30,0.5); color: #f0d8b0;
  box-shadow: inset 0 1px 0 rgba(200,60,40,0.3), 0 4px 16px rgba(0,0,0,0.5);
}
.rop-home-btn--crimson:hover {
  background: linear-gradient(180deg, rgba(180,30,24,0.9), rgba(120,20,16,0.92));
  border-color: rgba(200,50,40,0.6); color: #ffe0c0;
  box-shadow: inset 0 1px 0 rgba(220,80,50,0.35), 0 6px 20px rgba(0,0,0,0.6), 0 0 20px rgba(180,40,30,0.15);
}
.rop-home-btn--gold {
  background: linear-gradient(180deg, rgba(157,113,52,0.55), rgba(100,70,30,0.7));
  border-color: rgba(180,130,60,0.35); color: #f0e0c0;
  box-shadow: inset 0 1px 0 rgba(200,150,70,0.2), 0 4px 16px rgba(0,0,0,0.5);
}
.rop-home-btn--gold:hover {
  background: linear-gradient(180deg, rgba(180,130,60,0.65), rgba(120,80,40,0.75));
  border-color: rgba(200,150,70,0.5); color: #fff8e0;
  box-shadow: inset 0 1px 0 rgba(220,170,80,0.25), 0 6px 20px rgba(0,0,0,0.6), 0 0 20px rgba(180,130,50,0.15);
}
.rop-home-btn--dark {
  background: linear-gradient(180deg, rgba(30,25,18,0.85), rgba(20,16,10,0.9));
  border-color: rgba(157,113,52,0.25); color: #d4d6d8;
  box-shadow: inset 0 1px 0 rgba(60,45,20,0.3), 0 4px 16px rgba(0,0,0,0.5);
}
.rop-home-btn--dark:hover {
  background: linear-gradient(180deg, rgba(40,32,22,0.9), rgba(25,20,14,0.92));
  border-color: rgba(180,130,60,0.35); color: #e4e5e6;
  box-shadow: inset 0 1px 0 rgba(80,60,30,0.35), 0 6px 20px rgba(0,0,0,0.6);
}

/* ==========================================================================
   7. TOP ROW — 3-COLUMN GRID
   ========================================================================== */
.rop-home-upper { width: 100%; max-width: 1480px; margin: 0 auto; padding: 28px 16px 0; }
.rop-home-upper__grid { display: grid; grid-template-columns: 1.2fr 0.8fr 1fr; gap: 18px; }

/* ==========================================================================
   8. ORNATE PANEL SYSTEM — THE CORE ARCHITECTURE
   ========================================================================== */
.rop-ornate-panel__outer {
  position: relative;
  background: linear-gradient(180deg, var(--orn-stone-2), var(--orn-stone-1));
  border: 2px solid var(--orn-gold-dark);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.6), 0 0 0 4px rgba(0,0,0,0.5), 0 0 0 5px rgba(90,62,26,0.2), 0 6px 28px rgba(0,0,0,0.6);
  padding: 5px;
}

/* Ornate corners */
.rop-ornate-corner { position: absolute; width: 36px; height: 36px; pointer-events: none; z-index: 10; }
.rop-ornate-corner::before, .rop-ornate-corner::after {
  content: ""; position: absolute;
  background: linear-gradient(135deg, rgba(184,138,66,0.75), rgba(157,113,52,0.35));
  box-shadow: 0 0 5px rgba(200,150,70,0.15);
}
.rop-ornate-corner::before { width: 36px; height: 2px; }
.rop-ornate-corner::after { width: 2px; height: 36px; }
.rop-ornate-corner--tl { top: -2px; left: -2px; }
.rop-ornate-corner--tl::before { top: 0; left: 0; } .rop-ornate-corner--tl::after { top: 0; left: 0; }
.rop-ornate-corner--tr { top: -2px; right: -2px; }
.rop-ornate-corner--tr::before { top: 0; right: 0; } .rop-ornate-corner--tr::after { top: 0; right: 0; }
.rop-ornate-corner--bl { bottom: -2px; left: -2px; }
.rop-ornate-corner--bl::before { bottom: 0; left: 0; } .rop-ornate-corner--bl::after { bottom: 0; left: 0; }
.rop-ornate-corner--br { bottom: -2px; right: -2px; }
.rop-ornate-corner--br::before { bottom: 0; right: 0; } .rop-ornate-corner--br::after { bottom: 0; right: 0; }

/* Inner rail */
.rop-ornate-panel__rail {
  position: absolute; inset: 6px; pointer-events: none; z-index: 1;
  border: 1px solid rgba(157,113,52,0.2);
  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.4);
}
.rop-ornate-panel__rail-top, .rop-ornate-panel__rail-bottom {
  position: absolute; left: 12px; right: 12px; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(184,138,66,0.3) 20%, rgba(184,138,66,0.3) 80%, transparent);
}
.rop-ornate-panel__rail-top { top: 1px; }
.rop-ornate-panel__rail-bottom { bottom: 1px; }

/* Inner frame */
.rop-ornate-panel__inner {
  position: relative; z-index: 2;
  background: linear-gradient(180deg, var(--orn-stone-1), var(--orn-stone-0));
  border: 1px solid rgba(120,90,40,0.2);
  box-shadow: inset 0 2px 8px rgba(0,0,0,0.5);
  display: flex; flex-direction: column; min-height: 100%;
}

/* Panel header */
.rop-ornate-panel__header {
  display: flex; align-items: center; gap: 10px; padding: 12px 16px;
  background: linear-gradient(180deg, rgba(157,113,52,0.12), rgba(157,113,52,0.04));
  border-bottom: 1px solid rgba(157,113,52,0.2); position: relative;
}
.rop-ornate-panel__header::after {
  content: ""; position: absolute; bottom: -1px; left: 16px; right: 16px; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(184,138,66,0.2), transparent);
}
.rop-ornate-panel__header h3 {
  font-family: var(--orn-font-display); font-size: 0.8rem; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase; color: var(--orn-gold-pale); margin: 0; line-height: 1.2;
}

/* Small crest icon in header */
.rop-ornate-panel__crest {
  width: 18px; height: 18px; flex-shrink: 0;
  background: linear-gradient(135deg, rgba(184,138,66,0.5), rgba(157,113,52,0.2));
  transform: rotate(45deg); border: 1px solid rgba(184,138,66,0.3); position: relative;
}
.rop-ornate-panel__crest::after {
  content: ""; position: absolute; inset: 3px; background: var(--orn-stone-1); transform: rotate(0deg);
}
.rop-ornate-panel__crest--factions { width: 22px; height: 22px; }

/* Content well */
.rop-ornate-panel__well {
  flex: 1; padding: 14px 16px;
  background: linear-gradient(180deg, rgba(0,0,0,0.25), rgba(0,0,0,0.1)), var(--orn-stone-0);
  box-shadow: inset 0 4px 12px rgba(0,0,0,0.5); position: relative;
}
.rop-ornate-panel__well--art { padding: 0; overflow: hidden; }

/* Panel footer */
.rop-ornate-panel__footer {
  padding: 10px 16px; border-top: 1px solid rgba(157,113,52,0.15);
  background: linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0.05));
}

/* Ornate CTA */
.rop-ornate-cta {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--orn-font-display); font-size: 0.7rem; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--orn-crimson-light);
  text-decoration: none !important; transition: color 0.18s, text-shadow 0.18s;
}
.rop-ornate-cta:hover { color: var(--orn-crimson-glow); text-shadow: 0 0 8px rgba(200,60,40,0.25); }
.rop-ornate-cta--play { color: var(--orn-gold-pale); }
.rop-ornate-cta--play:hover { color: #fff0c8; text-shadow: 0 0 10px rgba(200,150,70,0.3); }

/* ==========================================================================
   9. NEWS LIST
   ========================================================================== */
.rop-news-list { display: flex; flex-direction: column; gap: 10px; }
.rop-news-item { padding-bottom: 10px; border-bottom: 1px solid rgba(157,113,52,0.1); }
.rop-news-item:last-child { padding-bottom: 0; border-bottom: 0; }
.rop-news-item__date {
  display: block; font-family: var(--orn-font-display); font-size: 0.62rem; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--orn-gold-mid); margin-bottom: 3px;
}
.rop-news-item h4 {
  font-family: var(--orn-font-display); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.03em;
  color: var(--orn-text-heading); margin: 0 0 3px; line-height: 1.3;
}
.rop-news-item p {
  font-family: var(--orn-font-body); font-size: 0.82rem; color: var(--orn-text-muted); margin: 0; line-height: 1.4;
}

/* ==========================================================================
   10. SERVER STATUS
   ========================================================================== */
.rop-status-display { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 8px 0; }
.rop-status-display__main { display: flex; align-items: center; gap: 10px; }
.rop-status-lamp { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 8px currentColor; }
.rop-status-lamp--online { background: #3a8; color: #3a8; box-shadow: 0 0 10px rgba(50,170,130,0.5); }
.rop-status-lamp--offline { background: #833; color: #833; box-shadow: 0 0 8px rgba(180,40,40,0.4); }
.rop-status-display__state {
  font-family: var(--orn-font-display); font-size: 1.3rem; font-weight: 700;
  letter-spacing: 0.12em; color: var(--orn-text-bright);
  text-shadow: 0 1px 3px rgba(0,0,0,0.5);
}
.rop-status-display__detail { display: flex; flex-direction: column; gap: 6px; width: 100%; }
.rop-status-detail-row {
  display: flex; justify-content: space-between; align-items: center; padding: 6px 10px;
  background: rgba(0,0,0,0.2); border: 1px solid rgba(157,113,52,0.08);
}
.rop-status-detail-row__label { font-family: var(--orn-font-body); font-size: 0.82rem; color: var(--orn-text-muted); }
.rop-status-detail-row__value { font-family: var(--orn-font-display); font-size: 0.82rem; font-weight: 600; color: var(--orn-text-heading); }
.rop-status-detail-row__value--enabled { color: #5a8; }

/* ==========================================================================
   11. YOUR ACCOUNT
   ========================================================================== */
.rop-account-links { display: flex; flex-direction: column; gap: 2px; }
.rop-account-link {
  display: flex; align-items: center; gap: 10px; padding: 9px 12px;
  font-family: var(--orn-font-display); font-size: 0.74rem; font-weight: 600;
  letter-spacing: 0.05em; text-transform: uppercase; color: var(--orn-text);
  text-decoration: none !important; background: rgba(0,0,0,0.15);
  border: 1px solid rgba(157,113,52,0.08); transition: all 0.18s ease;
}
.rop-account-link:hover { color: var(--orn-gold-pale); background: rgba(157,113,52,0.08); border-color: rgba(157,113,52,0.2); }
.rop-account-link__icon { font-size: 0.5rem; color: var(--orn-gold-mid); flex-shrink: 0; }
.rop-account-link--primary {
  color: var(--orn-gold-pale); background: rgba(139,26,20,0.15); border-color: rgba(180,40,30,0.2);
}
.rop-account-link--primary:hover { background: rgba(180,30,24,0.22); border-color: rgba(200,50,40,0.3); }
.rop-account-link--play {
  color: var(--orn-gold-pale); font-weight: 700; background: rgba(157,113,52,0.12); border-color: rgba(180,130,60,0.2);
}
.rop-account-link--play:hover { background: rgba(180,130,60,0.18); border-color: rgba(200,150,70,0.3); }

/* ==========================================================================
   12. SECOND ROW — 3-COLUMN GRID
   ========================================================================== */
.rop-home-lower { width: 100%; max-width: 1480px; margin: 0 auto; padding: 18px 16px; }
.rop-home-lower__grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; }

/* ==========================================================================
   13. FACTIONS DUAL LAYOUT
   ========================================================================== */
.rop-factions-dual { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; height: 100%; }
.rop-faction-card {
  position: relative; overflow: hidden; background: var(--orn-void);
  border: 1px solid rgba(157,113,52,0.15); display: flex; flex-direction: column;
}
.rop-faction-card__art { position: relative; width: 100%; height: 180px; overflow: hidden; }
.rop-faction-card__art img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
.rop-faction-card__veil {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(5,4,3,0.85) 100%); pointer-events: none;
}
.rop-faction-card--valroian .rop-faction-card__veil { background: linear-gradient(180deg, transparent 40%, rgba(8,12,24,0.85) 100%); }
.rop-faction-card--mordrath .rop-faction-card__veil { background: linear-gradient(180deg, transparent 40%, rgba(24,6,5,0.85) 100%); }
.rop-faction-card__emblem-wrap {
  position: absolute; top: 8px; right: 8px; width: 42px; height: 42px; z-index: 5;
  background: rgba(0,0,0,0.5); border: 1px solid rgba(157,113,52,0.2);
  display: flex; align-items: center; justify-content: center;
}
.rop-faction-card__emblem { width: 32px; height: 32px; object-fit: contain; }
.rop-faction-card__info {
  padding: 10px 12px; background: var(--orn-stone-0); flex: 1;
  display: flex; flex-direction: column; justify-content: flex-end;
}
.rop-faction-card__alignment {
  font-family: var(--orn-font-display); font-size: 0.58rem; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--orn-gold-mid); margin-bottom: 3px;
}
.rop-faction-card__info h4 {
  font-family: var(--orn-font-display); font-size: 0.9rem; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--orn-text-bright); margin: 0 0 6px;
}
.rop-faction-card__link {
  font-family: var(--orn-font-display); font-size: 0.62rem; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase; color: #f0d8b0;
  text-decoration: none !important; display: inline-block;
  padding: 0.4rem 0.9rem; margin-top: 6px;
  background: linear-gradient(180deg, rgba(139,26,20,0.85), rgba(90,16,12,0.9));
  border: 1px solid rgba(180,60,46,0.4);
  transition: all 0.18s ease;
}
.rop-faction-card__link:hover {
  color: #ffe0c0;
  background: linear-gradient(180deg, rgba(180,30,24,0.9), rgba(120,20,16,0.92));
  border-color: rgba(200,50,40,0.5);
}
.rop-faction-card--valroian .rop-faction-card__info h4 { color: #c8d8f0; }
.rop-faction-card--mordrath .rop-faction-card__info h4 { color: #f0c8c0; }

/* ==========================================================================
   14. EXPLORE THE REALM
   ========================================================================== */
.rop-explore-feature {
  position: relative; display: block; width: 100%; height: 280px; overflow: hidden;
  text-decoration: none !important; border-bottom: 1px solid rgba(157,113,52,0.15);
}
.rop-explore-feature img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
.rop-explore-feature__shade {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 35%, rgba(5,4,3,0.8) 100%); pointer-events: none;
}
.rop-explore-feature__frame { position: absolute; inset: 10px; border: 1px solid rgba(157,113,52,0.15); pointer-events: none; }
.rop-explore-feature__content { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px 16px; z-index: 3; }
.rop-explore-feature__content small {
  display: block; font-family: var(--orn-font-display); font-size: 0.6rem; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--orn-gold-mid); margin-bottom: 3px;
}
.rop-explore-feature__content strong {
  display: block; font-family: var(--orn-font-display); font-size: 0.9rem; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase; color: var(--orn-text-bright); margin-bottom: 4px;
}
.rop-explore-feature__content em {
  display: block; font-family: var(--orn-font-body); font-size: 0.82rem; font-style: italic; color: #b8b9ba;
}

/* Explore mini items */
.rop-explore-mini { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
.rop-explore-mini__item {
  position: relative; display: block; height: 120px; overflow: hidden;
  text-decoration: none !important; border-right: 1px solid rgba(157,113,52,0.1);
}
.rop-explore-mini__item:last-child { border-right: 0; }
.rop-explore-mini__item img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rop-explore-mini__shade {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgba(5,4,3,0.8) 100%); pointer-events: none;
}
.rop-explore-mini__label { position: absolute; bottom: 0; left: 0; right: 0; padding: 12px 10px; z-index: 3; }
.rop-explore-mini__label small {
  display: block; font-family: var(--orn-font-display); font-size: 0.55rem; font-weight: 600;
  letter-spacing: 0.06em; text-transform: uppercase; color: var(--orn-gold-mid); margin-bottom: 1px;
}
.rop-explore-mini__label strong {
  display: block; font-family: var(--orn-font-display); font-size: 0.7rem; font-weight: 700;
  letter-spacing: 0.05em; text-transform: uppercase; color: var(--orn-text-bright);
}

/* ==========================================================================
   15. BEGIN YOUR PASSAGE
   ========================================================================== */
.rop-begin-links { display: flex; flex-direction: column; gap: 3px; }
.rop-begin-link {
  display: flex; align-items: center; gap: 10px; padding: 8px 10px;
  text-decoration: none !important; background: rgba(0,0,0,0.15);
  border: 1px solid rgba(157,113,52,0.08); transition: all 0.18s ease;
}
.rop-begin-link:hover { background: rgba(157,113,52,0.08); border-color: rgba(157,113,52,0.2); }
.rop-begin-link__icon { width: 52px; height: 38px; flex-shrink: 0; overflow: hidden; border: 1px solid rgba(157,113,52,0.15); }
.rop-begin-link__icon img { width: 100%; height: 100%; object-fit: cover; display: block; }
.rop-begin-link__text { display: flex; flex-direction: column; gap: 1px; }
.rop-begin-link__text strong {
  font-family: var(--orn-font-display); font-size: 0.7rem; font-weight: 700;
  letter-spacing: 0.04em; text-transform: uppercase; color: var(--orn-text-heading);
}
.rop-begin-link__text small { font-family: var(--orn-font-body); font-size: 0.72rem; color: var(--orn-text-muted); }

/* ==========================================================================
   16. LOWER SHOWCASE
   ========================================================================== */
.rop-home-showcase { width: 100%; max-width: 1480px; margin: 0 auto; padding: 18px 16px 28px; }
.rop-home-showcase__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.rop-showcase-card {
  position: relative; display: block; height: 320px; overflow: hidden; text-decoration: none !important;
  border: 2px solid rgba(157,113,52,0.2);
  box-shadow: 0 0 0 4px rgba(0,0,0,0.5), 0 0 0 5px rgba(90,62,26,0.15), 0 6px 28px rgba(0,0,0,0.55);
  transition: border-color 0.25s, box-shadow 0.25s;
}
.rop-showcase-card:hover {
  border-color: rgba(184,138,66,0.4);
  box-shadow: 0 0 0 4px rgba(0,0,0,0.5), 0 0 0 5px rgba(120,80,40,0.25), 0 8px 32px rgba(0,0,0,0.6);
}
.rop-showcase-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
.rop-showcase-card:hover img { transform: scale(1.03); }
.rop-showcase-card__shade {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgba(5,4,3,0.85) 100%); pointer-events: none;
}
.rop-showcase-card__frame { position: absolute; inset: 12px; border: 1px solid rgba(157,113,52,0.15); pointer-events: none; }
.rop-showcase-card__content { position: absolute; bottom: 0; left: 0; right: 0; padding: 24px 20px; z-index: 3; }
.rop-showcase-card__content small {
  display: block; font-family: var(--orn-font-display); font-size: 0.64rem; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--orn-gold-mid); margin-bottom: 3px;
}
.rop-showcase-card__content strong {
  display: block; font-family: var(--orn-font-display); font-size: 1rem; font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--orn-text-bright); margin-bottom: 4px;
}
.rop-showcase-card__content em {
  display: block; font-family: var(--orn-font-body); font-size: 0.85rem; font-style: italic; color: #b8b9ba;
}

/* ==========================================================================
   17. FOOTER
   ========================================================================== */
.rop-footer {
  background: var(--orn-black-stone) !important; border-top: 2px solid var(--orn-gold-dark) !important;
  color: #80745f !important; box-shadow: inset 0 2px 0 rgba(10,8,5,0.8); padding: 16px 0 !important;
}

/* ==========================================================================
   18. RESPONSIVE
   ========================================================================== */
@media (max-width: 1200px) {
  .rop-home-upper__grid { grid-template-columns: 1.15fr 0.85fr 1fr; gap: 14px; }
  .rop-home-lower__grid { gap: 14px; }
  .rop-factions-dual { grid-template-columns: 1fr; }
  .rop-faction-card__art { height: 140px; }
}
@media (max-width: 1024px) {
  .rop-home-upper__grid { grid-template-columns: 1fr 1fr; gap: 14px; }
  .rop-ornate-panel--account { grid-column: 1 / -1; }
  .rop-home-lower__grid { grid-template-columns: 1fr 1fr; gap: 14px; }
  .rop-ornate-panel--begin { grid-column: 1 / -1; }
  .rop-home-hero { min-height: 520px; }
  .rop-navbar .nav-link { font-size: 0.68rem; padding: 1.2rem 0.5rem 1rem !important; }
}
@media (max-width: 768px) {
  .rop-home-upper { padding: 20px 10px 0; }
  .rop-home-upper__grid { grid-template-columns: 1fr; gap: 14px; }
  .rop-home-lower { padding: 14px 10px; }
  .rop-home-lower__grid { grid-template-columns: 1fr; gap: 14px; }
  .rop-home-showcase { padding: 14px 10px 20px; }
  .rop-home-showcase__grid { grid-template-columns: 1fr; gap: 14px; }
  .rop-home-hero { min-height: 460px; max-height: 560px; }
  .rop-home-hero__frame { inset: 10px; }
  .rop-corner { width: 36px; height: 36px; }
  .rop-corner::before { width: 36px; } .rop-corner::after { height: 36px; }
  .rop-home-hero__logo { max-width: 400px; max-height: 140px; }
  .rop-home-hero__tagline { font-size: 0.9rem; }
  .rop-navbar { padding: 6px 12px !important; min-height: 56px; }
  .rop-navbar-brand .navbar-brand-logo { height: 36px !important; max-width: 140px !important; }
  .rop-navbar .nav-link { padding: 0.7rem 0.6rem !important; font-size: 0.65rem; }
  .rop-showcase-card { height: 240px; }
  .rop-explore-feature { height: 200px; }
}
@media (max-width: 520px) {
  .rop-home-hero { min-height: 400px; }
  .rop-home-hero__frame { inset: 6px; }
  .rop-corner { width: 28px; height: 28px; }
  .rop-corner::before { width: 28px; height: 2px; } .rop-corner::after { width: 2px; height: 28px; }
  .rop-ornate-corner { width: 24px; height: 24px; }
  .rop-ornate-corner::before { width: 24px; } .rop-ornate-corner::after { height: 24px; }
  .rop-home-hero__logo { max-width: 300px; max-height: 110px; }
  .rop-home-hero__tagline { font-size: 0.72rem; }
  .rop-home-hero__lede { font-size: 0.85rem; }
  .rop-home-hero__actions { flex-direction: column; width: 100%; }
  .rop-home-btn { width: 100%; min-width: 0; }
  .rop-explore-mini { grid-template-columns: 1fr; }
  .rop-explore-mini__item { border-right: 0; border-bottom: 1px solid rgba(157,113,52,0.1); }
  .rop-factions-dual { grid-template-columns: 1fr; }
  .rop-showcase-card { height: 200px; }
}
@media (prefers-reduced-motion: reduce) {
  .rop-showcase-card img, .rop-home-btn, .rop-account-link, .rop-begin-link, .rop-ornate-cta { transition: none; }
}
